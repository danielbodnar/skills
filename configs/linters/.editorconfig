# EditorConfig
# https://editorconfig.org
#
# Usage: Copy to project root as .editorconfig

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

[*.rs]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[justfile]
indent_size = 4

[*.{diff,patch}]
trim_trailing_whitespace = false
insert_final_newline = false
