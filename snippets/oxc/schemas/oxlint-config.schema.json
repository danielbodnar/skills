{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxlint Configuration Schema",
  "description": "Configuration schema for oxlint JavaScript/TypeScript linter",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for IDE support"
    },
    "plugins": {
      "type": "array",
      "description": "List of plugins to enable",
      "items": {
        "type": "string",
        "enum": [
          "import",
          "typescript",
          "unicorn",
          "react",
          "jest",
          "vitest",
          "node",
          "promise"
        ]
      },
      "uniqueItems": true
    },
    "extends": {
      "type": "array",
      "description": "Configuration presets to extend from",
      "items": {
        "type": "string",
        "enum": [
          "oxlint:recommended",
          "oxlint:all"
        ]
      },
      "uniqueItems": true
    },
    "env": {
      "type": "object",
      "description": "Environment globals",
      "properties": {
        "browser": {
          "type": "boolean",
          "description": "Browser global variables"
        },
        "node": {
          "type": "boolean",
          "description": "Node.js global variables"
        },
        "es6": {
          "type": "boolean",
          "description": "ES6 global variables"
        },
        "es2017": {
          "type": "boolean",
          "description": "ES2017 global variables"
        },
        "es2020": {
          "type": "boolean",
          "description": "ES2020 global variables"
        },
        "es2021": {
          "type": "boolean",
          "description": "ES2021 global variables"
        },
        "es2022": {
          "type": "boolean",
          "description": "ES2022 global variables"
        },
        "es2024": {
          "type": "boolean",
          "description": "ES2024 global variables"
        },
        "jest": {
          "type": "boolean",
          "description": "Jest global variables"
        },
        "vitest": {
          "type": "boolean",
          "description": "Vitest global variables"
        }
      },
      "additionalProperties": false
    },
    "globals": {
      "type": "object",
      "description": "Additional global variables",
      "patternProperties": {
        ".*": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": ["readonly", "writable", "off"]
            }
          ]
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Rule configurations",
      "patternProperties": {
        ".*": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["off", "warn", "error", "0", "1", "2"]
            },
            {
              "type": "number",
              "enum": [0, 1, 2]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": [
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["off", "warn", "error", "0", "1", "2"]
                    },
                    {
                      "type": "number",
                      "enum": [0, 1, 2]
                    }
                  ]
                },
                {
                  "type": "object"
                }
              ]
            }
          ]
        }
      }
    },
    "categories": {
      "type": "object",
      "description": "Category-level rule configuration",
      "properties": {
        "correctness": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["off", "warn", "error"]
            },
            {
              "type": "number",
              "enum": [0, 1, 2]
            }
          ]
        },
        "style": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["off", "warn", "error"]
            },
            {
              "type": "number",
              "enum": [0, 1, 2]
            }
          ]
        },
        "pedantic": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["off", "warn", "error"]
            },
            {
              "type": "number",
              "enum": [0, 1, 2]
            }
          ]
        },
        "suspicious": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["off", "warn", "error"]
            },
            {
              "type": "number",
              "enum": [0, 1, 2]
            }
          ]
        },
        "restriction": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["off", "warn", "error"]
            },
            {
              "type": "number",
              "enum": [0, 1, 2]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "Plugin-specific settings",
      "properties": {
        "import": {
          "type": "object",
          "properties": {
            "resolver": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "overrides": {
      "type": "array",
      "description": "File-specific configuration overrides",
      "items": {
        "type": "object",
        "properties": {
          "files": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "excludedFiles": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "env": {
            "$ref": "#/properties/env"
          },
          "globals": {
            "$ref": "#/properties/globals"
          },
          "rules": {
            "$ref": "#/properties/rules"
          },
          "categories": {
            "$ref": "#/properties/categories"
          },
          "settings": {
            "$ref": "#/properties/settings"
          }
        },
        "required": ["files"],
        "additionalProperties": false
      }
    },
    "ignorePatterns": {
      "type": "array",
      "description": "Patterns to ignore during linting",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}