{
  "name": "oxc-example-project",
  "version": "1.0.0",
  "description": "Example project using Oxc tools",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "oxc-transform src/ --out-dir dist/",
    "build:declarations": "oxc-transform src/ --declaration --out-dir dist/",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint --quiet",
    "lint:src": "oxlint src/",
    "lint:tests": "oxlint **/*.test.{js,ts}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "oxc-transform --check src/",
    "quality": "bun run lint && bun run format:check && bun run type-check",
    "test": "bun test",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "effect": "latest",
    "@effect/schema": "latest"
  },
  "devDependencies": {
    "oxlint": "latest",
    "oxc-transform": "latest",
    "oxc-resolver": "latest",
    "prettier": "latest",
    "@prettier/plugin-oxc": "latest",
    "typescript": "latest",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "bun run quality"
    }
  }
}