{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Typesense Collection Schema",
  "description": "Schema definition for Typesense collections",
  "required": ["name", "fields"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Collection name (alphanumeric, underscore, hyphen only)"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "description": "Array of field definitions",
      "items": {
        "$ref": "#/definitions/field"
      }
    },
    "default_sorting_field": {
      "type": "string",
      "description": "Field used for default sorting (must be a numeric field defined in fields array)"
    },
    "token_separators": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1
      },
      "description": "Characters used to split text into tokens"
    },
    "symbols_to_index": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1
      },
      "description": "Symbols that should be indexed as part of tokens"
    },
    "enable_nested_fields": {
      "type": "boolean",
      "description": "Enable automatic indexing of nested object fields"
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Field name (must start with letter, alphanumeric + underscore)"
        },
        "type": {
          "type": "string",
          "enum": [
            "string", "int32", "int64", "float", "bool", "geopoint",
            "string[]", "int32[]", "int64[]", "float[]", "bool[]", "geopoint[]"
          ],
          "description": "Field data type"
        },
        "facet": {
          "type": "boolean",
          "description": "Whether this field can be used for faceting"
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this field is optional in documents"
        },
        "index": {
          "type": "boolean",
          "description": "Whether this field should be indexed for searching"
        },
        "sort": {
          "type": "boolean",
          "description": "Whether this field can be used for sorting"
        },
        "infix": {
          "type": "boolean",
          "description": "Whether to enable infix searching on this field"
        },
        "locale": {
          "type": "string",
          "description": "Locale for language-specific text processing"
        },
        "stem": {
          "type": "boolean",
          "description": "Whether to enable stemming for this field"
        },
        "embed": {
          "type": "object",
          "description": "Configuration for automatic embedding generation",
          "required": ["from", "model_config"],
          "properties": {
            "from": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Source fields to generate embeddings from"
            },
            "model_config": {
              "type": "object",
              "required": ["model_name"],
              "properties": {
                "model_name": {
                  "type": "string",
                  "description": "Name of the embedding model to use"
                }
              }
            }
          }
        }
      }
    }
  }
}