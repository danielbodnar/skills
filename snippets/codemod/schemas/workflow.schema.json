{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codemod Workflow Schema",
  "description": "Schema for Codemod workflow.yaml files",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Workflow schema version",
      "enum": [1]
    },
    "state": {
      "type": "object",
      "description": "Shared state schema definition",
      "additionalProperties": {
        "$ref": "#/$defs/stateProperty"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Workflow execution nodes",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    }
  },
  "required": ["version", "nodes"],
  "additionalProperties": false,
  "$defs": {
    "stateProperty": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "number", "boolean", "object", "array"]
            }
          },
          "required": ["type"]
        },
        {
          "type": "string",
          "pattern": "^!(string|number|boolean|object|array)$",
          "description": "YAML tag notation for type"
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "$ref": "#/$defs/stateProperty",
              "description": "Array item type definition"
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/stateProperty"
              },
              "description": "Object property definitions"
            },
            "additionalProperties": {
              "type": "boolean",
              "description": "Allow additional properties"
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable node name"
        },
        "type": {
          "type": "string",
          "enum": ["automatic", "manual"],
          "description": "Node execution type"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of node IDs this node depends on"
        },
        "condition": {
          "type": "string",
          "description": "Condition for node execution"
        },
        "matrix": {
          "type": "object",
          "description": "Matrix strategy for parallel execution",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^!state ",
                "description": "Reference to state variable"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Static list of values"
              }
            ]
          }
        },
        "steps": {
          "type": "array",
          "description": "Execution steps for this node",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        }
      },
      "required": ["id", "name", "type", "steps"],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "description": "Shell command or script to execute"
        },
        "name": {
          "type": "string",
          "description": "Step name for logging"
        },
        "working_directory": {
          "type": "string",
          "description": "Working directory for command execution"
        },
        "env": {
          "type": "object",
          "description": "Environment variables for this step",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "integer",
          "description": "Timeout in seconds",
          "minimum": 1
        },
        "retry": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Number of retry attempts"
            },
            "delay": {
              "type": "integer",
              "minimum": 0,
              "description": "Delay between retries in seconds"
            }
          },
          "additionalProperties": false
        },
        "continue_on_error": {
          "type": "boolean",
          "description": "Whether to continue workflow on step failure",
          "default": false
        }
      },
      "required": ["run"],
      "additionalProperties": false
    }
  }
}