{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bootc.dev/schemas/status-v1.json",
  "title": "bootc Status API v1",
  "description": "Schema for bootc status --json --format-version=1 output",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "org.containers.bootc/v1"
    },
    "kind": {
      "type": "string",
      "const": "BootcHost"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Host identifier"
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "image": {
          "type": ["string", "null"],
          "description": "Container image reference being tracked"
        },
        "bootOrder": {
          "type": "string",
          "enum": ["default", "rollback"],
          "description": "Boot order preference"
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "booted": {
          "type": ["object", "null"],
          "description": "Currently booted deployment",
          "$ref": "#/$defs/Deployment"
        },
        "staged": {
          "type": ["object", "null"],
          "description": "Staged deployment for next boot",
          "$ref": "#/$defs/Deployment"
        },
        "rollback": {
          "type": ["object", "null"],
          "description": "Previous deployment available for rollback",
          "$ref": "#/$defs/Deployment"
        },
        "rollbackQueued": {
          "type": "boolean",
          "description": "Whether a rollback is queued for next boot"
        },
        "type": {
          "type": "string",
          "description": "Type of bootc system"
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "spec", "status"],
  "$defs": {
    "Deployment": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "imageReference": {
              "type": "string",
              "description": "Full container image reference"
            },
            "version": {
              "type": "string",
              "description": "Image version or tag"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Image build timestamp"
            },
            "imageDigest": {
              "type": "string",
              "description": "Container image digest"
            }
          },
          "required": ["imageReference"]
        },
        "ostree": {
          "type": "object",
          "properties": {
            "checksum": {
              "type": "string",
              "description": "OSTree commit checksum"
            },
            "deploySerial": {
              "type": "integer",
              "description": "Deployment serial number"
            }
          }
        },
        "booted": {
          "type": "boolean",
          "description": "Whether this deployment is currently booted"
        },
        "staged": {
          "type": "boolean",
          "description": "Whether this deployment is staged for next boot"
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether this deployment is pinned"
        }
      },
      "required": ["image"]
    }
  }
}