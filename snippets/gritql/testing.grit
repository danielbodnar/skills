# GritQL Testing Patterns and Examples

# Testing Framework Migration Patterns

# Jest to Vitest migration
engine marzano(0.1)
language js

# Convert Jest imports to Vitest
`import { $imports } from 'jest'` => `import { $imports } from 'vitest'`

# Convert Jest globals to Vitest imports
`describe($name, $fn)` => `describe($name, $fn)` where {
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ describe }`)
}

`it($name, $fn)` => `test($name, $fn)` where {
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ test }`)
}

`expect($value)` => `expect($value)` where {
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ expect }`)
}

# Mocha to Jest migration
`const expect = require('chai').expect` => `// Removed chai import` where {
  file($f) <: contains `jest`
}

`it($description, function() {
  $body
})` => `test($description, () => {
  $body
})`

# Test structure improvements
`test($name, () => {
  $setup
  $assertion
})` => `test($name, () => {
  // Arrange
  $setup
  
  // Assert
  $assertion
})` where {
  $setup <: not contains `//`,
  $assertion <: contains `expect`
}

# Add missing test descriptions
`test('', $fn)` => `test('should behave correctly', $fn)`

# Convert sync tests to async when needed
`test($name, () => {
  $body
})` => `test($name, async () => {
  $body
})` where {
  $body <: contains or {
    `await`,
    `Promise`,
    `.then(`,
    `.catch(`
  }
}

# Assertion improvements
`expect($actual).toBe($expected)` => `expect($actual).toEqual($expected)` where {
  $expected <: or {
    object_expression(),
    array_expression()
  }
}

`expect($actual == $expected).toBe(true)` => `expect($actual).toEqual($expected)`

`expect($actual != $expected).toBe(true)` => `expect($actual).not.toEqual($expected)`

# Mock improvements
`jest.fn()` => `vi.fn()` where {
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ vi }`)
}

`jest.mock($module)` => `vi.mock($module)` where {
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ vi }`)
}

`jest.spyOn($obj, $method)` => `vi.spyOn($obj, $method)` where {
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ vi }`)
}

# Test organization patterns
`describe($name, () => {
  $tests
})` => `describe($name, () => {
  $tests
})` where {
  $tests <: not contains `beforeEach`,
  $tests <: contains bubble($name) {
    `test($testName, $fn)` => `test($testName, $fn)` where {
      file($f) <: ensure_import_from(source=`'vitest'`, import=`{ beforeEach }`)
    }
  }
}

# Add setup and teardown
`describe($name, () => {
  $tests
})` => `describe($name, () => {
  beforeEach(() => {
    // Setup for each test
  });
  
  afterEach(() => {
    // Cleanup after each test
  });
  
  $tests
})` where {
  $tests <: not contains or { `beforeEach`, `afterEach` },
  file($f) <: ensure_import_from(source=`'vitest'`, import=`{ beforeEach, afterEach }`)
}

# React Testing Library patterns
`import { render } from '@testing-library/react'` => 
`import { render, screen } from '@testing-library/react'`

# Improve test queries
`container.querySelector($selector)` => `screen.getByTestId($testId)` where {
  $selector <: string(),
  $testId = extract_test_id($selector)
}

`getByText($text)` => `screen.getByText($text)`

`getByRole($role)` => `screen.getByRole($role)`

# Event testing improvements
`fireEvent.click($element)` => `await user.click($element)` where {
  file($f) <: ensure_import_from(source=`'@testing-library/user-event'`, import=`user`)
}

`fireEvent.change($input, { target: { value: $value } })` => 
`await user.type($input, $value)` where {
  file($f) <: ensure_import_from(source=`'@testing-library/user-event'`, import=`user`)
}

# Async testing patterns
`waitFor(() => {
  expect($assertion)
})` => `await waitFor(() => {
  expect($assertion)
})` where {
  file($f) <: ensure_import_from(source=`'@testing-library/react'`, import=`{ waitFor }`)
}

# Test data factories
`const user = {
  id: 1,
  name: 'Test User',
  email: 'test@example.com'
}` => `const user = createTestUser()` where {
  file($f) <: ensure_import_from(source=`'./test-factories'`, import=`{ createTestUser }`)
}

# Snapshot testing improvements
`expect($component).toMatchSnapshot()` => 
`expect($component).toMatchSnapshot({
  id: expect.any(String),
  createdAt: expect.any(Date)
})`

# Error testing patterns
`expect(() => {
  $code
}).toThrow()` => `expect(() => {
  $code
}).toThrow($expectedError)` where {
  $expectedError = `'Expected error message'`
}

# API testing patterns
`fetch($url)` => `mockFetch($url)` where {
  file($f) <: contains `test`,
  file($f) <: ensure_import_from(source=`'./test-utils'`, import=`{ mockFetch }`)
}

# Performance testing
`test($name, $fn)` => `test($name, $fn, { timeout: 10000 })` where {
  $fn <: contains or {
    `await`,
    `Promise`,
    `setTimeout`
  }
}

# Test coverage improvements
`if ($condition) {
  $code
}` => `if ($condition) {
  $code
} else {
  // This branch should be tested
}` where {
  file($f) <: ends_with(`.test.js`),
  $code <: not contains `throw`
}

# Parameterized testing
`test('should handle different values', () => {
  expect(fn(1)).toBe(2);
  expect(fn(2)).toBe(4);
  expect(fn(3)).toBe(6);
})` => `test.each([
  [1, 2],
  [2, 4], 
  [3, 6]
])('should handle value %i and return %i', (input, expected) => {
  expect(fn(input)).toBe(expected);
})`

# Test isolation improvements
`const spy = jest.spyOn($obj, $method)` => 
`const spy = jest.spyOn($obj, $method);
afterEach(() => {
  spy.mockRestore();
})`

# Custom matchers
`expect($actual.length).toBe(0)` => `expect($actual).toHaveLength(0)`

`expect($array.includes($item)).toBe(true)` => `expect($array).toContain($item)`

`expect(typeof $value).toBe('string')` => `expect($value).toBeTypeOf('string')`

# Test naming improvements
`test('test 1', $fn)` => `test('should return expected value when given valid input', $fn)`

`test('error', $fn)` => `test('should throw error when given invalid input', $fn)` where {
  $fn <: contains `toThrow`
}

# Cleanup patterns
`afterEach(() => {
  jest.clearAllMocks();
})` => `afterEach(() => {
  vi.clearAllMocks();
  cleanup();
})` where {
  file($f) <: ensure_import_from(source=`'@testing-library/react'`, import=`{ cleanup }`)
}