{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Engineering Schema",
  "description": "Schema for context engineering structures and configurations",
  "type": "object",
  "definitions": {
    "ContextElement": {
      "type": "object",
      "required": ["type", "content", "priority", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["system", "user", "memory", "tool", "knowledge", "state", "workflow", "debug"]
        },
        "content": {
          "type": "string",
          "description": "The actual content of the context element"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Priority level for context ordering"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the context element was created"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Source of the context element"
            },
            "relevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Relevance score for current context"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tags for categorization"
            },
            "expires": {
              "type": "string",
              "format": "date-time",
              "description": "When the context element expires"
            }
          }
        }
      }
    },
    "ContextWindow": {
      "type": "object",
      "required": ["maxTokens", "currentTokens", "elements"],
      "properties": {
        "maxTokens": {
          "type": "number",
          "minimum": 1,
          "description": "Maximum number of tokens allowed"
        },
        "currentTokens": {
          "type": "number",
          "minimum": 0,
          "description": "Current number of tokens used"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContextElement"
          },
          "description": "Array of context elements"
        },
        "compressionRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Compression ratio applied to context"
        }
      }
    },
    "MemoryItem": {
      "type": "object",
      "required": ["id", "content", "type", "importance", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$",
          "description": "Unique identifier for memory item"
        },
        "content": {
          "type": "string",
          "description": "Content of the memory item"
        },
        "type": {
          "type": "string",
          "enum": ["fact", "procedure", "episodic", "semantic", "working"],
          "description": "Type of memory"
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Importance score for memory item"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the memory was created"
        },
        "lastAccessed": {
          "type": "string",
          "format": "date-time",
          "description": "When the memory was last accessed"
        },
        "accessCount": {
          "type": "number",
          "minimum": 0,
          "description": "Number of times memory was accessed"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorization"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Source of the memory"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in memory accuracy"
            },
            "context": {
              "type": "string",
              "description": "Context when memory was created"
            }
          }
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Vector embedding for similarity search"
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "description": "IDs of connected memory items"
        }
      }
    },
    "WorkflowStep": {
      "type": "object",
      "required": ["id", "name", "description", "context", "dependencies", "outputs", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-_]+$",
          "description": "Unique identifier for workflow step"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the step"
        },
        "description": {
          "type": "string",
          "description": "Description of what the step does"
        },
        "command": {
          "type": "string",
          "description": "Command to execute for this step"
        },
        "context": {
          "type": "object",
          "description": "Context information for the step"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step IDs that must complete before this step"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Output variables produced by this step"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "failed"],
          "description": "Current status of the step"
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "description": "When the step started execution"
        },
        "endTime": {
          "type": "string",
          "format": "date-time",
          "description": "When the step completed execution"
        },
        "result": {
          "type": "object",
          "description": "Result of step execution"
        },
        "error": {
          "type": "string",
          "description": "Error message if step failed"
        }
      }
    },
    "ClaudeContext": {
      "type": "object",
      "required": ["projectInstructions", "codeStyle", "buildCommands", "references", "workflowRules"],
      "properties": {
        "projectInstructions": {
          "type": "string",
          "description": "Project-specific instructions for Claude"
        },
        "codeStyle": {
          "type": "string",
          "description": "Code style guidelines"
        },
        "buildCommands": {
          "type": "string",
          "description": "Build and development commands"
        },
        "references": {
          "type": "string",
          "description": "Reference documentation links"
        },
        "workflowRules": {
          "type": "string",
          "description": "Workflow and process rules"
        },
        "customCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Custom slash commands available"
        },
        "toolPermissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tool permissions granted"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "When the context was last updated"
        }
      }
    },
    "ContextQuery": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "Content to search for"
        },
        "type": {
          "type": "string",
          "enum": ["system", "user", "memory", "tool", "knowledge", "state"],
          "description": "Type of context to search"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags to filter by"
        },
        "minImportance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum importance score"
        },
        "maxAge": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum age in days"
        },
        "limit": {
          "type": "number",
          "minimum": 1,
          "description": "Maximum number of results"
        },
        "includeConnections": {
          "type": "boolean",
          "description": "Whether to include connected items"
        }
      }
    },
    "ContextEngineering": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Schema version"
        },
        "context": {
          "$ref": "#/definitions/ContextWindow"
        },
        "memory": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MemoryItem"
          }
        },
        "workflow": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowStep"
          }
        },
        "configuration": {
          "type": "object",
          "properties": {
            "maxContextTokens": {
              "type": "number",
              "minimum": 1024,
              "description": "Maximum context window size"
            },
            "compressionThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "When to trigger context compression"
            },
            "memoryRetentionDays": {
              "type": "number",
              "minimum": 1,
              "description": "How long to retain memories"
            },
            "workingMemorySize": {
              "type": "number",
              "minimum": 1,
              "description": "Size of working memory"
            },
            "importanceThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Minimum importance for retention"
            }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "description": "Current session identifier"
            },
            "agentType": {
              "type": "string",
              "enum": ["claude-code", "goose", "generic"],
              "description": "Type of AI agent"
            },
            "environment": {
              "type": "string",
              "enum": ["terminal", "web", "desktop", "mobile"],
              "description": "Operating environment"
            },
            "created": {
              "type": "string",
              "format": "date-time",
              "description": "When the context was created"
            },
            "lastModified": {
              "type": "string",
              "format": "date-time",
              "description": "When the context was last modified"
            }
          }
        }
      }
    }
  },
  "properties": {
    "contextEngineering": {
      "$ref": "#/definitions/ContextEngineering"
    }
  }
}