{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bun Configuration Schema",
  "description": "Schema for bunfig.toml configuration file",
  "type": "object",
  "properties": {
    "install": {
      "type": "object",
      "description": "Package installation configuration",
      "properties": {
        "registry": {
          "oneOf": [
            {
              "type": "string",
              "description": "Default registry URL"
            },
            {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "token": { "type": "string" },
                "username": { "type": "string" },
                "password": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "scopes": {
          "type": "object",
          "description": "Scoped package registry configuration",
          "patternProperties": {
            "^@[a-z0-9-~][a-z0-9-._~]*$": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string" },
                    "token": { "type": "string" },
                    "username": { "type": "string" },
                    "password": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "production": {
          "type": "boolean",
          "description": "Install for production (excludes devDependencies)",
          "default": false
        },
        "saveTextLockfile": {
          "type": "boolean",
          "description": "Save a text-based lockfile",
          "default": false
        },
        "frozenLockfile": {
          "type": "boolean",
          "description": "Disallow changes to lockfile",
          "default": false
        },
        "dryRun": {
          "type": "boolean",
          "description": "Don't actually install packages",
          "default": false
        },
        "optional": {
          "type": "boolean",
          "description": "Install optionalDependencies",
          "default": true
        },
        "dev": {
          "type": "boolean",
          "description": "Install devDependencies",
          "default": true
        },
        "peer": {
          "type": "boolean",
          "description": "Install peerDependencies",
          "default": true
        },
        "globalDir": {
          "type": "string",
          "description": "Directory for global packages",
          "default": "~/.bun/install/global"
        },
        "globalBinDir": {
          "type": "string",
          "description": "Directory for global package bins",
          "default": "~/.bun/bin"
        },
        "cache": {
          "type": "object",
          "description": "Cache configuration",
          "properties": {
            "dir": {
              "type": "string",
              "description": "Cache directory",
              "default": "~/.bun/install/cache"
            },
            "disable": {
              "type": "boolean",
              "description": "Disable cache",
              "default": false
            },
            "disableManifest": {
              "type": "boolean",
              "description": "Disable manifest cache",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "lockfile": {
          "type": "object",
          "description": "Lockfile configuration",
          "properties": {
            "save": {
              "type": "boolean",
              "description": "Save lockfile to disk",
              "default": true
            },
            "print": {
              "type": "string",
              "enum": ["yarn"],
              "description": "Print lockfile in specified format"
            }
          },
          "additionalProperties": false
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "error", "warn"],
          "description": "Log level for install operations",
          "default": "warn"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "description": "Runtime configuration",
      "properties": {
        "bun": {
          "type": "boolean",
          "description": "Use Bun runtime",
          "default": true
        },
        "silent": {
          "type": "boolean",
          "description": "Suppress output",
          "default": false
        },
        "shell": {
          "type": "string",
          "description": "Shell to use for running scripts",
          "default": "bash"
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "description": "Test configuration",
      "properties": {
        "coverage": {
          "type": "boolean",
          "description": "Enable code coverage",
          "default": false
        },
        "preload": {
          "type": "array",
          "description": "Files to preload before running tests",
          "items": { "type": "string" }
        },
        "smol": {
          "type": "boolean",
          "description": "Use smol mode for tests",
          "default": false
        },
        "timeout": {
          "type": "number",
          "description": "Test timeout in milliseconds",
          "default": 5000
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "description": "Build configuration",
      "properties": {
        "minify": {
          "type": "boolean",
          "description": "Enable minification",
          "default": false
        },
        "sourcemap": {
          "type": "string",
          "enum": ["none", "linked", "inline", "external"],
          "description": "Sourcemap generation type",
          "default": "none"
        },
        "splitting": {
          "type": "boolean",
          "description": "Enable code splitting",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}