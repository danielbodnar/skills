{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orama Database Schema",
  "description": "JSON Schema for Orama database configuration and document structure",
  "type": "object",
  "properties": {
    "schema": {
      "type": "object",
      "description": "Database schema definition",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "string",
                "number", 
                "boolean",
                "string[]",
                "number[]",
                "enum",
                "geopoint"
              ]
            },
            {
              "type": "string",
              "pattern": "^vector\\[[0-9]+\\]$"
            },
            {
              "type": "object",
              "description": "Nested object schema",
              "additionalProperties": {
                "$ref": "#/properties/schema/patternProperties/^[a-zA-Z_][a-zA-Z0-9_]*$"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "description": "Database components configuration",
      "properties": {
        "tokenizer": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": ["english", "spanish", "french", "german", "italian", "auto"]
            },
            "stemming": {
              "type": "boolean",
              "default": true
            },
            "stemmerSkipProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "caseSensitive": {
              "type": "boolean",
              "default": false
            },
            "normalization": {
              "type": "boolean",
              "default": true
            },
            "maxTokenLength": {
              "type": "number",
              "minimum": 1
            },
            "stopwords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "customStopwords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "index": {
          "type": "object",
          "properties": {
            "caseSensitive": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "description": "Array of plugin instances",
      "items": {
        "type": "object"
      }
    }
  },
  "required": ["schema"],
  "additionalProperties": false,
  
  "definitions": {
    "searchParams": {
      "type": "object",
      "properties": {
        "term": {
          "type": "string",
          "description": "Search query"
        },
        "mode": {
          "type": "string",
          "enum": ["fulltext", "vector", "hybrid"],
          "default": "fulltext"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "where": {
          "type": "object",
          "description": "Filter conditions"
        },
        "sortBy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string"
                },
                "order": {
                  "type": "string",
                  "enum": ["ASC", "DESC"]
                }
              },
              "required": ["property", "order"]
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "property": {
                    "type": "string"
                  },
                  "order": {
                    "type": "string",
                    "enum": ["ASC", "DESC"]
                  }
                },
                "required": ["property", "order"]
              }
            }
          ]
        },
        "limit": {
          "type": "number",
          "minimum": 1
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boost": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "facets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "number"
              },
              "order": {
                "type": "string",
                "enum": ["ASC", "DESC"]
              },
              "ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": ["string", "number"]
                    },
                    "to": {
                      "type": ["string", "number"]
                    }
                  },
                  "required": ["from", "to"]
                }
              }
            }
          }
        },
        "groupBy": {
          "type": "object",
          "properties": {
            "properties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxResult": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": ["properties"]
        }
      },
      "required": ["term"]
    },
    
    "geopoint": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number", 
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": ["lat", "lon"]
    },
    
    "radiusFilter": {
      "type": "object",
      "properties": {
        "coordinates": {
          "$ref": "#/definitions/geopoint"
        },
        "unit": {
          "type": "string",
          "enum": ["m", "km", "ft", "yd", "mi", "cm"]
        },
        "value": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["coordinates", "value"]
    },
    
    "polygonFilter": {
      "type": "object",
      "properties": {
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/geopoint"
          },
          "minItems": 4
        }
      },
      "required": ["coordinates"]
    }
  }
}