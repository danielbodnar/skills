{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quarto.org/schemas/project.json",
  "title": "Quarto Project Configuration",
  "description": "Schema for _quarto.yml project configuration files",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["default", "website", "book", "manuscript"],
          "description": "Type of Quarto project"
        },
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "output-dir": {
          "type": "string",
          "description": "Directory for rendered output",
          "default": "_site"
        },
        "render": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files or patterns to render"
        },
        "preview": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port for preview server"
            },
            "browser": {
              "type": "boolean",
              "description": "Open browser automatically"
            },
            "watch-inputs": {
              "type": "boolean",
              "description": "Watch input files for changes"
            },
            "navigate": {
              "type": "boolean",
              "description": "Navigate to changed files"
            }
          }
        }
      },
      "required": ["type"]
    },
    "website": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Website title"
        },
        "description": {
          "type": "string",
          "description": "Website description"
        },
        "site-url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL for the website"
        },
        "repo-url": {
          "type": "string",
          "format": "uri",
          "description": "Repository URL"
        },
        "navbar": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Navbar title"
            },
            "logo": {
              "type": "string",
              "description": "Path to logo image"
            },
            "search": {
              "type": "boolean",
              "description": "Enable search functionality"
            },
            "left": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/navItem"
              }
            },
            "right": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/navItem"
              }
            },
            "background": {
              "type": "string",
              "enum": ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark"]
            }
          }
        },
        "sidebar": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            },
            "search": {
              "type": "boolean"
            },
            "contents": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/sidebarItem"
              }
            },
            "style": {
              "type": "string",
              "enum": ["docked", "floating"]
            },
            "collapse-level": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "page-footer": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "left": {
                  "oneOf": [
                    {"type": "string"},
                    {"type": "array", "items": {"$ref": "#/definitions/navItem"}}
                  ]
                },
                "center": {
                  "oneOf": [
                    {"type": "string"},
                    {"type": "array", "items": {"$ref": "#/definitions/navItem"}}
                  ]
                },
                "right": {
                  "oneOf": [
                    {"type": "string"},
                    {"type": "array", "items": {"$ref": "#/definitions/navItem"}}
                  ]
                },
                "background": {
                  "type": "string",
                  "enum": ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark"]
                },
                "border": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "comments": {
          "type": "object",
          "properties": {
            "giscus": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[^/]+/[^/]+$"
                }
              },
              "required": ["repo"]
            },
            "hypothesis": {
              "type": "object",
              "properties": {
                "theme": {
                  "type": "string",
                  "enum": ["clean", "classic"]
                },
                "openSidebar": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "book": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Book title"
        },
        "subtitle": {
          "type": "string",
          "description": "Book subtitle"
        },
        "author": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Book author(s)"
        },
        "date": {
          "type": "string",
          "description": "Publication date"
        },
        "description": {
          "type": "string",
          "description": "Book description"
        },
        "cover-image": {
          "type": "string",
          "description": "Path to cover image"
        },
        "chapters": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "properties": {
                  "part": {"type": "string"},
                  "chapters": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                },
                "required": ["part", "chapters"]
              }
            ]
          }
        },
        "appendices": {
          "type": "array",
          "items": {"type": "string"}
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pdf", "epub", "docx"]
          }
        }
      }
    },
    "format": {
      "type": "object",
      "properties": {
        "html": {
          "$ref": "#/definitions/htmlFormat"
        },
        "pdf": {
          "$ref": "#/definitions/pdfFormat"
        },
        "docx": {
          "$ref": "#/definitions/docxFormat"
        },
        "revealjs": {
          "$ref": "#/definitions/revealjsFormat"
        }
      }
    },
    "execute": {
      "type": "object",
      "properties": {
        "cache": {
          "type": "boolean",
          "description": "Enable execution caching"
        },
        "freeze": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "string", "enum": ["auto", "true", "false"]}
          ],
          "description": "Freeze execution results"
        },
        "daemon": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "integer", "minimum": 0}
          ],
          "description": "Jupyter daemon timeout in seconds"
        },
        "enabled": {
          "type": "boolean",
          "description": "Enable code execution"
        },
        "echo": {
          "type": "boolean",
          "description": "Echo code in output"
        },
        "eval": {
          "type": "boolean",
          "description": "Evaluate code chunks"
        },
        "warning": {
          "type": "boolean",
          "description": "Include warnings in output"
        },
        "error": {
          "type": "boolean",
          "description": "Include errors in output"
        }
      }
    },
    "metadata-files": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Additional metadata files to include"
    }
  },
  "definitions": {
    "navItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {"type": "string"},
            "href": {"type": "string"},
            "icon": {"type": "string"},
            "aria-label": {"type": "string"}
          },
          "required": ["text"]
        },
        {
          "type": "object",
          "properties": {
            "text": {"type": "string"},
            "menu": {
              "type": "array",
              "items": {"$ref": "#/definitions/navItem"}
            }
          },
          "required": ["text", "menu"]
        },
        {
          "type": "string"
        }
      ]
    },
    "sidebarItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "section": {"type": "string"},
            "contents": {
              "type": "array",
              "items": {"$ref": "#/definitions/sidebarItem"}
            }
          },
          "required": ["section", "contents"]
        },
        {
          "type": "object",
          "properties": {
            "text": {"type": "string"},
            "href": {"type": "string"}
          },
          "required": ["text", "href"]
        },
        {
          "type": "string"
        }
      ]
    },
    "htmlFormat": {
      "type": "object",
      "properties": {
        "theme": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "css": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "toc": {"type": "boolean"},
        "toc-depth": {"type": "integer", "minimum": 1, "maximum": 6},
        "toc-title": {"type": "string"},
        "number-sections": {"type": "boolean"},
        "number-depth": {"type": "integer", "minimum": 1, "maximum": 6},
        "highlight-style": {"type": "string"},
        "code-fold": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "string", "enum": ["true", "false", "show"]}
          ]
        },
        "code-tools": {"type": "boolean"},
        "code-copy": {"type": "boolean"},
        "code-line-numbers": {"type": "boolean"},
        "smooth-scroll": {"type": "boolean"}
      }
    },
    "pdfFormat": {
      "type": "object",
      "properties": {
        "documentclass": {"type": "string"},
        "classoption": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "geometry": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "fontsize": {"type": "string"},
        "fontfamily": {"type": "string"},
        "colorlinks": {"type": "boolean"},
        "cite-method": {
          "type": "string",
          "enum": ["citeproc", "natbib", "biblatex"]
        },
        "keep-tex": {"type": "boolean"}
      }
    },
    "docxFormat": {
      "type": "object",
      "properties": {
        "reference-doc": {"type": "string"},
        "toc": {"type": "boolean"},
        "number-sections": {"type": "boolean"}
      }
    },
    "revealjsFormat": {
      "type": "object",
      "properties": {
        "theme": {"type": "string"},
        "transition": {
          "type": "string",
          "enum": ["none", "fade", "slide", "convex", "concave", "zoom"]
        },
        "transition-speed": {
          "type": "string",
          "enum": ["default", "fast", "slow"]
        },
        "slide-number": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "string"}
          ]
        },
        "chalkboard": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "object"}
          ]
        },
        "incremental": {"type": "boolean"},
        "auto-slide": {"type": "integer"},
        "logo": {"type": "string"},
        "footer": {"type": "string"},
        "preview-links": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "string", "enum": ["auto"]}
          ]
        }
      }
    }
  }
}