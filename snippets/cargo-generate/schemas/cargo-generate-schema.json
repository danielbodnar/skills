{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cargo-generate.github.io/cargo-generate/schema/cargo-generate.json",
  "title": "cargo-generate Template Configuration",
  "description": "Configuration schema for cargo-generate templates",
  "type": "object",
  "properties": {
    "template": {
      "type": "object",
      "description": "Template metadata and requirements",
      "properties": {
        "cargo_generate_version": {
          "type": "string",
          "description": "Minimum required cargo-generate version",
          "pattern": "^(>=|>|<=|<|=)?\\d+\\.\\d+\\.\\d+$",
          "examples": [">=0.18.0", "0.17.0"]
        },
        "description": {
          "type": "string",
          "description": "Template description"
        },
        "include": {
          "type": "array",
          "description": "Files/patterns to include in template processing",
          "items": {
            "type": "string"
          },
          "examples": ["src/**", "tests/**", "*.md"]
        },
        "exclude": {
          "type": "array", 
          "description": "Files/patterns to exclude from template processing",
          "items": {
            "type": "string"
          },
          "examples": ["target/**", "*.tmp", ".git/**"]
        }
      },
      "additionalProperties": false
    },
    "placeholders": {
      "type": "object",
      "description": "Template placeholder definitions",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_-]*$": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "text", "editor", "bool", "array"],
              "description": "Placeholder type"
            },
            "prompt": {
              "type": "string",
              "description": "User prompt message"
            },
            "default": {
              "description": "Default value for the placeholder",
              "oneOf": [
                {"type": "string"},
                {"type": "boolean"},
                {"type": "array", "items": {"type": "string"}}
              ]
            },
            "choices": {
              "type": "array",
              "description": "Available choices for selection",
              "items": {
                "type": "string"
              }
            },
            "regex": {
              "type": "string",
              "description": "Validation regex pattern"
            }
          },
          "required": ["type"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {"type": {"const": "bool"}}
              },
              "then": {
                "properties": {
                  "default": {"type": "boolean"}
                }
              }
            },
            {
              "if": {
                "properties": {"type": {"const": "array"}}
              },
              "then": {
                "properties": {
                  "default": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "conditional": {
      "type": "object",
      "description": "Conditional file inclusion/exclusion",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "description": "Files to include when condition is true",
              "items": {
                "type": "string"
              }
            },
            "ignore": {
              "type": "array",
              "description": "Files to ignore when condition is true", 
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "description": "Hook script configuration",
      "properties": {
        "pre": {
          "oneOf": [
            {"type": "string"},
            {
              "type": "array",
              "items": {"type": "string"}
            }
          ],
          "description": "Pre-generation hook scripts"
        },
        "post": {
          "oneOf": [
            {"type": "string"},
            {
              "type": "array", 
              "items": {"type": "string"}
            }
          ],
          "description": "Post-generation hook scripts"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "template": {
        "cargo_generate_version": ">=0.18.0",
        "description": "A Rust library template with async support"
      },
      "placeholders": {
        "project_description": {
          "type": "string",
          "prompt": "Enter project description",
          "default": "A new Rust project"
        },
        "use_async": {
          "type": "bool", 
          "prompt": "Use async/await?",
          "default": false
        },
        "license": {
          "type": "string",
          "prompt": "Choose license",
          "choices": ["MIT", "Apache-2.0", "GPL-3.0"],
          "default": "MIT"
        },
        "features": {
          "type": "array",
          "prompt": "Select features",
          "choices": ["serde", "tokio", "clap"],
          "default": []
        }
      },
      "conditional": {
        "use_async": {
          "include": ["src/async.rs"]
        },
        "license == \"MIT\"": {
          "include": ["LICENSE-MIT"],
          "ignore": ["LICENSE-APACHE"]
        }
      },
      "hooks": {
        "pre": ["hooks/pre-generate.rhai"],
        "post": ["hooks/post-generate.rhai"]
      }
    }
  ]
}