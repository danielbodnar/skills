# Cargo.toml.liquid - Template for Cargo.toml with Liquid templating

[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "{{rust_edition}}"
authors = [{{authors}}]
description = "{{project_description}}"
license = "{{license}}"
{% if repository_url != "" -%}
repository = "{{repository_url}}"
{% endif -%}
{% if documentation_url != "" -%}
documentation = "{{documentation_url}}"
{% endif -%}
{% if homepage_url != "" -%}
homepage = "{{homepage_url}}"
{% endif -%}
readme = "README.md"
keywords = [{% for keyword in keywords %}"{{keyword}}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
categories = [{% for category in categories %}"{{category}}"{% unless forloop.last %}, {% endunless %}{% endfor %}]

{% if crate_type == "bin" -%}
[[bin]]
name = "{{crate_name}}"
path = "src/main.rs"
{% endif -%}

{% if crate_type == "lib" -%}
[lib]
name = "{{crate_name | snake_case}}"
path = "src/lib.rs"
{% if lib_type != "lib" -%}
crate-type = ["{{lib_type}}"]
{% endif -%}
{% endif -%}

[dependencies]
{% if "serde" in features -%}
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
{% endif -%}
{% if "tokio" in features -%}
tokio = { version = "1.0", features = ["full"] }
{% endif -%}
{% if "clap" in features -%}
clap = { version = "4.0", features = ["derive"] }
{% endif -%}
{% if "anyhow" in features -%}
anyhow = "1.0"
{% endif -%}
{% if "tracing" in features -%}
tracing = "0.1"
tracing-subscriber = "0.3"
{% endif -%}
{% if "reqwest" in features -%}
reqwest = { version = "0.11", features = ["json"] }
{% endif -%}
{% if "diesel" in features -%}
diesel = { version = "2.0", features = ["postgres", "chrono"] }
{% endif -%}
{% if "sqlx" in features -%}
sqlx = { version = "0.7", features = ["runtime-tokio-rustls", "postgres", "chrono", "uuid"] }
{% endif -%}
{% if use_async -%}
futures = "0.3"
{% endif -%}

[dev-dependencies]
{% if use_testing -%}
tokio-test = "0.4"
{% endif -%}
{% if "proptest" in test_features -%}
proptest = "1.0"
{% endif -%}
{% if "criterion" in test_features -%}
criterion = "0.5"
{% endif -%}

{% if "criterion" in test_features -%}
[[bench]]
name = "{{crate_name}}_bench"
harness = false
{% endif -%}

{% if use_workspace -%}
[workspace]
members = [
    "{{crate_name}}-core",
    "{{crate_name}}-cli",
    "{{crate_name}}-web",
]
{% endif -%}

[profile.release]
{% if optimize_for_size -%}
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"
{% else -%}
opt-level = 3
lto = "thin"
{% endif -%}

{% if use_cargo_features -%}
[features]
default = [{% for feature in default_features %}"{{feature}}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
{% for feature_name, feature_deps in custom_features -%}
{{feature_name}} = [{% for dep in feature_deps %}"{{dep}}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
{% endfor -%}
{% endif -%}

{% if build_dependencies -%}
[build-dependencies]
{% for dep, version in build_dependencies -%}
{{dep}} = "{{version}}"
{% endfor -%}
{% endif -%}

{% if target_specific_deps -%}
# Platform-specific dependencies
[target.'cfg(windows)'.dependencies]
winapi = "0.3"

[target.'cfg(unix)'.dependencies]
libc = "0.2"
{% endif -%}