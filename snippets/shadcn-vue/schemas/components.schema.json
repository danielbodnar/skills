{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "shadcn-vue Components Configuration",
  "description": "Configuration schema for shadcn-vue components.json",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL",
      "default": "https://shadcn-vue.com/schema.json"
    },
    "style": {
      "type": "string",
      "description": "The style of the components",
      "enum": ["default", "new-york"],
      "default": "default"
    },
    "typescript": {
      "type": "boolean",
      "description": "Whether to use TypeScript",
      "default": true
    },
    "tailwind": {
      "type": "object",
      "description": "Tailwind CSS configuration",
      "properties": {
        "config": {
          "type": "string",
          "description": "Path to tailwind config file",
          "examples": ["tailwind.config.js", "tailwind.config.ts"]
        },
        "css": {
          "type": "string",
          "description": "Path to the CSS file",
          "examples": ["src/index.css", "app/globals.css", "src/styles/globals.css"]
        },
        "baseColor": {
          "type": "string",
          "description": "Base color for the components",
          "enum": ["gray", "neutral", "slate", "stone", "zinc"],
          "default": "slate"
        },
        "cssVariables": {
          "type": "boolean",
          "description": "Whether to use CSS variables for theming",
          "default": true
        },
        "prefix": {
          "type": "string",
          "description": "Prefix for Tailwind CSS utility classes",
          "default": ""
        }
      },
      "required": ["config", "css", "baseColor", "cssVariables"],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "description": "Import aliases for different directories",
      "properties": {
        "components": {
          "type": "string",
          "description": "Alias for components directory",
          "examples": ["@/components", "~/components"]
        },
        "composables": {
          "type": "string",
          "description": "Alias for composables directory (Nuxt specific)",
          "examples": ["@/composables", "~/composables"]
        },
        "utils": {
          "type": "string",
          "description": "Alias for utils directory",
          "examples": ["@/lib/utils", "~/lib/utils"]
        },
        "ui": {
          "type": "string",
          "description": "Alias for UI components directory",
          "examples": ["@/components/ui", "~/components/ui"]
        },
        "lib": {
          "type": "string",
          "description": "Alias for lib directory",
          "examples": ["@/lib", "~/lib"]
        }
      },
      "additionalProperties": true
    },
    "iconLibrary": {
      "type": "string",
      "description": "Icon library to use",
      "enum": ["lucide"],
      "default": "lucide"
    }
  },
  "required": ["style", "typescript", "tailwind", "aliases"],
  "additionalProperties": false,
  "examples": [
    {
      "$schema": "https://shadcn-vue.com/schema.json",
      "style": "new-york",
      "typescript": true,
      "tailwind": {
        "config": "tailwind.config.js",
        "css": "src/index.css",
        "baseColor": "neutral",
        "cssVariables": true,
        "prefix": ""
      },
      "aliases": {
        "components": "@/components",
        "utils": "@/lib/utils",
        "ui": "@/components/ui",
        "lib": "@/lib"
      },
      "iconLibrary": "lucide"
    },
    {
      "$schema": "https://shadcn-vue.com/schema.json",
      "style": "default",
      "typescript": true,
      "tailwind": {
        "config": "tailwind.config.ts",
        "css": "~/assets/css/tailwind.css",
        "baseColor": "zinc",
        "cssVariables": true,
        "prefix": ""
      },
      "aliases": {
        "components": "~/components",
        "composables": "~/composables",
        "utils": "~/lib/utils",
        "ui": "~/components/ui",
        "lib": "~/lib"
      },
      "iconLibrary": "lucide"
    }
  ]
}