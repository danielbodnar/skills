{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pine Script API Schema",
  "description": "Schema for Pine Script API structures and data formats",
  "type": "object",
  "properties": {
    "indicator": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "shorttitle": {"type": "string"},
        "overlay": {"type": "boolean"},
        "format": {"type": "string", "enum": ["price", "volume", "percent"]},
        "precision": {"type": "integer", "minimum": 0},
        "scale": {"type": "string", "enum": ["left", "right", "none"]},
        "max_bars_back": {"type": "integer", "minimum": 1},
        "max_lines_count": {"type": "integer", "minimum": 1, "maximum": 500},
        "max_labels_count": {"type": "integer", "minimum": 1, "maximum": 500},
        "max_boxes_count": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "required": ["title"]
    },
    "strategy": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "shorttitle": {"type": "string"},
        "overlay": {"type": "boolean"},
        "initial_capital": {"type": "number", "minimum": 0},
        "default_qty_type": {"type": "string", "enum": ["strategy.fixed", "strategy.percent_of_equity", "strategy.cash"]},
        "default_qty_value": {"type": "number", "minimum": 0},
        "commission_type": {"type": "string", "enum": ["strategy.commission.percent", "strategy.commission.cash_per_contract", "strategy.commission.cash_per_order"]},
        "commission_value": {"type": "number", "minimum": 0},
        "slippage": {"type": "number", "minimum": 0},
        "currency": {"type": "string"},
        "margin_long": {"type": "number", "minimum": 0},
        "margin_short": {"type": "number", "minimum": 0},
        "pyramiding": {"type": "integer", "minimum": 0},
        "calc_on_order_fills": {"type": "boolean"},
        "calc_on_every_tick": {"type": "boolean"},
        "close_entries_rule": {"type": "string", "enum": ["NONE", "FIFO", "LIFO"]},
        "process_orders_on_close": {"type": "boolean"}
      },
      "required": ["title"]
    },
    "input": {
      "type": "object",
      "properties": {
        "bool": {
          "type": "object",
          "properties": {
            "defval": {"type": "boolean"},
            "title": {"type": "string"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"},
            "confirm": {"type": "boolean"}
          },
          "required": ["defval"]
        },
        "int": {
          "type": "object",
          "properties": {
            "defval": {"type": "integer"},
            "title": {"type": "string"},
            "minval": {"type": "integer"},
            "maxval": {"type": "integer"},
            "step": {"type": "integer"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"},
            "confirm": {"type": "boolean"}
          },
          "required": ["defval"]
        },
        "float": {
          "type": "object",
          "properties": {
            "defval": {"type": "number"},
            "title": {"type": "string"},
            "minval": {"type": "number"},
            "maxval": {"type": "number"},
            "step": {"type": "number"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"},
            "confirm": {"type": "boolean"}
          },
          "required": ["defval"]
        },
        "string": {
          "type": "object",
          "properties": {
            "defval": {"type": "string"},
            "title": {"type": "string"},
            "options": {"type": "array", "items": {"type": "string"}},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"},
            "confirm": {"type": "boolean"}
          },
          "required": ["defval"]
        },
        "color": {
          "type": "object",
          "properties": {
            "defval": {"type": "string"},
            "title": {"type": "string"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"}
          },
          "required": ["defval"]
        },
        "source": {
          "type": "object",
          "properties": {
            "defval": {"type": "string"},
            "title": {"type": "string"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"}
          },
          "required": ["defval"]
        },
        "session": {
          "type": "object",
          "properties": {
            "defval": {"type": "string", "pattern": "^\\d{4}-\\d{4}$"},
            "title": {"type": "string"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"}
          },
          "required": ["defval"]
        },
        "time": {
          "type": "object",
          "properties": {
            "defval": {"type": "integer"},
            "title": {"type": "string"},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"},
            "confirm": {"type": "boolean"}
          },
          "required": ["defval"]
        },
        "timeframe": {
          "type": "object",
          "properties": {
            "defval": {"type": "string"},
            "title": {"type": "string"},
            "options": {"type": "array", "items": {"type": "string"}},
            "tooltip": {"type": "string"},
            "inline": {"type": "string"},
            "group": {"type": "string"}
          },
          "required": ["defval"]
        }
      }
    },
    "plot": {
      "type": "object",
      "properties": {
        "series": {"type": "string"},
        "title": {"type": "string"},
        "color": {"type": "string"},
        "linewidth": {"type": "integer", "minimum": 1, "maximum": 4},
        "style": {"type": "string", "enum": ["plot.style_line", "plot.style_stepline", "plot.style_histogram", "plot.style_cross", "plot.style_area", "plot.style_columns", "plot.style_circles", "plot.style_linebr", "plot.style_stepline_diamond"]},
        "trackprice": {"type": "boolean"},
        "histbase": {"type": "number"},
        "offset": {"type": "integer"},
        "join": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "show_last": {"type": "integer", "minimum": 1},
        "display": {"type": "string", "enum": ["display.none", "display.data_window", "display.pane", "display.price_scale", "display.status_line", "display.all"]}
      },
      "required": ["series"]
    },
    "plotshape": {
      "type": "object",
      "properties": {
        "series": {"type": "string"},
        "title": {"type": "string"},
        "style": {"type": "string", "enum": ["shape.xcross", "shape.cross", "shape.triangleup", "shape.triangledown", "shape.flag", "shape.circle", "shape.arrowup", "shape.arrowdown", "shape.labelup", "shape.labeldown", "shape.square", "shape.diamond"]},
        "location": {"type": "string", "enum": ["location.abovebar", "location.belowbar", "location.top", "location.bottom", "location.absolute"]},
        "color": {"type": "string"},
        "textcolor": {"type": "string"},
        "size": {"type": "string", "enum": ["size.auto", "size.tiny", "size.small", "size.normal", "size.large", "size.huge"]},
        "text": {"type": "string"},
        "char": {"type": "string"}
      },
      "required": ["series"]
    },
    "alertcondition": {
      "type": "object",
      "properties": {
        "condition": {"type": "string"},
        "title": {"type": "string"},
        "message": {"type": "string"},
        "freq": {"type": "string", "enum": ["alert.freq_once_per_bar", "alert.freq_once_per_bar_close", "alert.freq_all"]}
      },
      "required": ["condition", "title", "message"]
    },
    "strategy_orders": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "direction": {"type": "string", "enum": ["strategy.long", "strategy.short"]},
            "qty": {"type": "number"},
            "limit": {"type": "number"},
            "stop": {"type": "number"},
            "oca_type": {"type": "string", "enum": ["strategy.oca.cancel", "strategy.oca.reduce", "strategy.oca.none"]},
            "comment": {"type": "string"},
            "alert_message": {"type": "string"},
            "when": {"type": "string"}
          },
          "required": ["id", "direction"]
        },
        "exit": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "from_entry": {"type": "string"},
            "qty": {"type": "number"},
            "qty_percent": {"type": "number"},
            "profit": {"type": "number"},
            "loss": {"type": "number"},
            "trail_points": {"type": "number"},
            "trail_offset": {"type": "number"},
            "limit": {"type": "number"},
            "stop": {"type": "number"},
            "comment": {"type": "string"},
            "alert_message": {"type": "string"},
            "when": {"type": "string"}
          },
          "required": ["id"]
        },
        "close": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "when": {"type": "string"},
            "qty": {"type": "number"},
            "qty_percent": {"type": "number"},
            "comment": {"type": "string"},
            "alert_message": {"type": "string"},
            "immediately": {"type": "boolean"}
          }
        },
        "close_all": {
          "type": "object",
          "properties": {
            "when": {"type": "string"},
            "comment": {"type": "string"},
            "alert_message": {"type": "string"},
            "immediately": {"type": "boolean"}
          }
        }
      }
    },
    "technical_analysis": {
      "type": "object",
      "properties": {
        "sma": {"type": "object", "properties": {"source": {"type": "string"}, "length": {"type": "integer"}}},
        "ema": {"type": "object", "properties": {"source": {"type": "string"}, "length": {"type": "integer"}}},
        "rsi": {"type": "object", "properties": {"source": {"type": "string"}, "length": {"type": "integer"}}},
        "macd": {"type": "object", "properties": {"source": {"type": "string"}, "fastlength": {"type": "integer"}, "slowlength": {"type": "integer"}, "signallength": {"type": "integer"}}},
        "bollinger_bands": {"type": "object", "properties": {"source": {"type": "string"}, "length": {"type": "integer"}, "mult": {"type": "number"}}},
        "stochastic": {"type": "object", "properties": {"source": {"type": "string"}, "high": {"type": "string"}, "low": {"type": "string"}, "length": {"type": "integer"}}},
        "atr": {"type": "object", "properties": {"length": {"type": "integer"}}},
        "adx": {"type": "object", "properties": {"length": {"type": "integer"}}},
        "cci": {"type": "object", "properties": {"source": {"type": "string"}, "length": {"type": "integer"}}}
      }
    },
    "request_security": {
      "type": "object",
      "properties": {
        "symbol": {"type": "string"},
        "timeframe": {"type": "string"},
        "expression": {"type": "string"},
        "gaps": {"type": "string", "enum": ["barmerge.gaps_off", "barmerge.gaps_on"]},
        "lookahead": {"type": "string", "enum": ["barmerge.lookahead_off", "barmerge.lookahead_on"]},
        "ignore_invalid_symbol": {"type": "boolean"}
      },
      "required": ["symbol", "timeframe", "expression"]
    },
    "label": {
      "type": "object",
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "number"},
        "text": {"type": "string"},
        "xloc": {"type": "string", "enum": ["xloc.bar_index", "xloc.bar_time"]},
        "yloc": {"type": "string", "enum": ["yloc.price", "yloc.abovebar", "yloc.belowbar"]},
        "color": {"type": "string"},
        "style": {"type": "string", "enum": ["label.style_none", "label.style_label_up", "label.style_label_down", "label.style_label_left", "label.style_label_right", "label.style_label_center", "label.style_arrowup", "label.style_arrowdown", "label.style_flag"]},
        "textcolor": {"type": "string"},
        "size": {"type": "string", "enum": ["size.auto", "size.tiny", "size.small", "size.normal", "size.large", "size.huge"]},
        "tooltip": {"type": "string"}
      },
      "required": ["x", "y"]
    },
    "line": {
      "type": "object",
      "properties": {
        "x1": {"type": "integer"},
        "y1": {"type": "number"},
        "x2": {"type": "integer"},
        "y2": {"type": "number"},
        "xloc": {"type": "string", "enum": ["xloc.bar_index", "xloc.bar_time"]},
        "extend": {"type": "string", "enum": ["extend.none", "extend.left", "extend.right", "extend.both"]},
        "color": {"type": "string"},
        "style": {"type": "string", "enum": ["line.style_solid", "line.style_dotted", "line.style_dashed", "line.style_arrow_left", "line.style_arrow_right", "line.style_arrow_both"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 4}
      },
      "required": ["x1", "y1", "x2", "y2"]
    },
    "box": {
      "type": "object",
      "properties": {
        "left": {"type": "integer"},
        "top": {"type": "number"},
        "right": {"type": "integer"},
        "bottom": {"type": "number"},
        "xloc": {"type": "string", "enum": ["xloc.bar_index", "xloc.bar_time"]},
        "bgcolor": {"type": "string"},
        "border_color": {"type": "string"},
        "border_width": {"type": "integer", "minimum": 1, "maximum": 4},
        "border_style": {"type": "string", "enum": ["line.style_solid", "line.style_dotted", "line.style_dashed"]},
        "extend": {"type": "string", "enum": ["extend.none", "extend.left", "extend.right", "extend.both"]},
        "text": {"type": "string"},
        "text_color": {"type": "string"},
        "text_size": {"type": "string", "enum": ["size.auto", "size.tiny", "size.small", "size.normal", "size.large", "size.huge"]}
      },
      "required": ["left", "top", "right", "bottom"]
    },
    "table": {
      "type": "object",
      "properties": {
        "position": {"type": "string", "enum": ["position.top_left", "position.top_center", "position.top_right", "position.middle_left", "position.middle_center", "position.middle_right", "position.bottom_left", "position.bottom_center", "position.bottom_right"]},
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "bgcolor": {"type": "string"},
        "border_color": {"type": "string"},
        "border_width": {"type": "integer", "minimum": 0},
        "frame_color": {"type": "string"},
        "frame_width": {"type": "integer", "minimum": 0}
      },
      "required": ["position", "columns", "rows"]
    },
    "variables": {
      "type": "object",
      "properties": {
        "price_data": {
          "type": "array",
          "items": {"type": "string", "enum": ["open", "high", "low", "close", "hl2", "hlc3", "ohlc4", "volume"]}
        },
        "time_data": {
          "type": "array", 
          "items": {"type": "string", "enum": ["time", "timenow", "year", "month", "weekofyear", "dayofmonth", "dayofweek", "hour", "minute", "second"]}
        },
        "symbol_info": {
          "type": "array",
          "items": {"type": "string", "enum": ["syminfo.basecurrency", "syminfo.currency", "syminfo.description", "syminfo.mintick", "syminfo.pointvalue", "syminfo.prefix", "syminfo.root", "syminfo.session", "syminfo.ticker", "syminfo.tickerid", "syminfo.timezone", "syminfo.type"]}
        },
        "barstate": {
          "type": "array",
          "items": {"type": "string", "enum": ["barstate.isconfirmed", "barstate.isfirst", "barstate.ishistory", "barstate.islast", "barstate.islastconfirmedhistory", "barstate.isnew", "barstate.isrealtime"]}
        },
        "strategy": {
          "type": "array",
          "items": {"type": "string", "enum": ["strategy.equity", "strategy.initial_capital", "strategy.grossloss", "strategy.grossprofit", "strategy.netprofit", "strategy.position_size", "strategy.position_avg_price", "strategy.opentrades", "strategy.closedtrades", "strategy.wintrades", "strategy.losstrades", "strategy.max_drawdown"]}
        }
      }
    }
  }
}