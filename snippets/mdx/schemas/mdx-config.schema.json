{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mdxjs.com/schemas/mdx-config.json",
  "title": "MDX Configuration",
  "description": "Configuration schema for MDX compilation options",
  "type": "object",
  "properties": {
    "jsxRuntime": {
      "type": "string",
      "enum": ["automatic", "classic"],
      "default": "automatic",
      "description": "Whether to use the automatic JSX runtime or classic runtime"
    },
    "jsxImportSource": {
      "type": "string",
      "default": "react",
      "description": "Import source for JSX. Examples: 'react', 'preact', 'vue', 'solid-js/h'"
    },
    "pragma": {
      "type": "string",
      "description": "JSX pragma (for classic runtime). Example: 'React.createElement'"
    },
    "pragmaFrag": {
      "type": "string",
      "description": "JSX fragment pragma (for classic runtime). Example: 'React.Fragment'"
    },
    "pragmaImportSource": {
      "type": "string",
      "description": "Import source for pragma (for classic runtime). Example: 'react'"
    },
    "format": {
      "type": "string",
      "enum": ["esm", "cjs"],
      "default": "esm",
      "description": "Module format for the output"
    },
    "outputFormat": {
      "type": "string",
      "enum": ["program", "function-body"],
      "default": "program",
      "description": "Output format for the compiled code"
    },
    "development": {
      "type": "boolean",
      "default": false,
      "description": "Whether to include development information for debugging"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "Base URL for resolving imports"
    },
    "providerImportSource": {
      "type": "string",
      "description": "Import source for the MDX provider. Example: '@mdx-js/react'"
    },
    "remarkPlugins": {
      "type": "array",
      "description": "Array of remark plugins to use for markdown processing",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin name"
          },
          {
            "type": "array",
            "description": "Plugin with options",
            "items": [
              {
                "type": "string",
                "description": "Plugin name"
              }
            ],
            "additionalItems": {
              "description": "Plugin options"
            }
          }
        ]
      }
    },
    "rehypePlugins": {
      "type": "array",
      "description": "Array of rehype plugins to use for HTML processing",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin name"
          },
          {
            "type": "array",
            "description": "Plugin with options",
            "items": [
              {
                "type": "string",
                "description": "Plugin name"
              }
            ],
            "additionalItems": {
              "description": "Plugin options"
            }
          }
        ]
      }
    },
    "recmaPlugins": {
      "type": "array",
      "description": "Array of recma plugins to use for ECMAScript processing",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin name"
          },
          {
            "type": "array",
            "description": "Plugin with options",
            "items": [
              {
                "type": "string",
                "description": "Plugin name"
              }
            ],
            "additionalItems": {
              "description": "Plugin options"
            }
          }
        ]
      }
    }
  },
  "examples": [
    {
      "jsxImportSource": "react",
      "remarkPlugins": ["remark-gfm"],
      "rehypePlugins": ["rehype-highlight"]
    },
    {
      "jsxImportSource": "preact",
      "providerImportSource": "@mdx-js/preact",
      "remarkPlugins": [
        "remark-gfm",
        ["remark-frontmatter", "yaml"]
      ],
      "rehypePlugins": [
        "rehype-slug",
        ["rehype-katex", {"strict": false}]
      ]
    },
    {
      "jsxRuntime": "classic",
      "pragma": "h",
      "pragmaFrag": "Fragment",
      "pragmaImportSource": "preact"
    }
  ],
  "definitions": {
    "plugin": {
      "oneOf": [
        {
          "type": "string",
          "description": "Plugin name"
        },
        {
          "type": "array",
          "description": "Plugin with options",
          "minItems": 1,
          "items": [
            {
              "type": "string",
              "description": "Plugin name"
            }
          ],
          "additionalItems": {
            "description": "Plugin options"
          }
        }
      ]
    }
  }
}