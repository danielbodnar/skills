{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Putout Configuration",
  "description": "Configuration file for Putout JavaScript linter and transformer",
  "properties": {
    "rules": {
      "type": "object",
      "description": "Rule configuration",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "enum": ["on", "off", "error", "warn"]
          },
          {
            "type": "array",
            "items": [
              {
                "type": "string",
                "enum": ["on", "off", "error", "warn"]
              },
              {
                "type": "object",
                "description": "Rule options"
              }
            ]
          }
        ]
      }
    },
    "plugins": {
      "type": "array",
      "description": "List of plugins to load",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin name"
          },
          {
            "type": "array",
            "items": [
              {
                "type": "string",
                "description": "Plugin name"
              },
              {
                "type": "object",
                "description": "Plugin options"
              }
            ]
          }
        ]
      }
    },
    "match": {
      "type": "object",
      "description": "File pattern matching for specific rules",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rules": {
            "$ref": "#/properties/rules"
          }
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["on", "off", "error", "warn"]
            },
            {
              "type": "array",
              "items": [
                {
                  "type": "string",
                  "enum": ["on", "off", "error", "warn"]
                },
                {
                  "type": "object"
                }
              ]
            }
          ]
        }
      }
    },
    "ignore": {
      "type": "array",
      "description": "Patterns to ignore",
      "items": {
        "type": "string"
      }
    },
    "processors": {
      "type": "array",
      "description": "List of processors to use",
      "items": {
        "type": "string",
        "enum": ["markdown", "yaml", "json", "ignore"]
      }
    },
    "formatter": {
      "type": "object",
      "description": "Formatter configuration",
      "properties": {
        "name": {
          "type": "string",
          "enum": ["json", "compact", "unix", "stylish"]
        },
        "options": {
          "type": "object",
          "properties": {
            "pretty": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Environment-specific configuration",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rules": {
            "$ref": "#/properties/rules"
          },
          "plugins": {
            "$ref": "#/properties/plugins"
          }
        }
      }
    },
    "extends": {
      "oneOf": [
        {
          "type": "string",
          "description": "Configuration to extend"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of configurations to extend"
        }
      ]
    },
    "rulesdir": {
      "type": "string",
      "description": "Directory containing custom rules"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "rules": {
        "remove-unused-variables": "on",
        "remove-debugger": "on",
        "convert-commonjs-to-esm": "off"
      },
      "plugins": [
        "remove-empty",
        "remove-useless-variables"
      ],
      "match": {
        "*.test.js": {
          "remove-only": "on"
        }
      },
      "ignore": [
        "node_modules",
        "dist"
      ]
    }
  ]
}