{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archlinux.org/schemas/pkgbuild.schema.json",
  "title": "PKGBUILD Schema",
  "description": "JSON schema for validating PKGBUILD structure and metadata",
  "type": "object",
  "properties": {
    "pkgname": {
      "description": "Name of the package",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9@._+-]+$",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9@._+-]+$",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "pkgbase": {
      "description": "Base package name for split packages",
      "type": "string",
      "pattern": "^[a-z0-9@._+-]+$",
      "minLength": 1
    },
    "pkgver": {
      "description": "Version of the software being packaged",
      "type": "string",
      "pattern": "^[a-zA-Z0-9.:+~-]+$",
      "minLength": 1
    },
    "pkgrel": {
      "description": "Package release number",
      "type": "integer",
      "minimum": 1
    },
    "epoch": {
      "description": "Epoch for version comparison",
      "type": "integer",
      "minimum": 0
    },
    "pkgdesc": {
      "description": "Brief description of the package",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "arch": {
      "description": "Architecture(s) the package is built for",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["any", "x86_64", "i686", "arm", "armv6h", "armv7h", "aarch64"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "url": {
      "description": "URL of the official site of the software",
      "type": "string",
      "format": "uri"
    },
    "license": {
      "description": "License(s) under which the software is distributed",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "groups": {
      "description": "Groups the package belongs to",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "depends": {
      "description": "Runtime dependencies",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([><=]+[a-zA-Z0-9.:+~-]+)?$"
      },
      "uniqueItems": true
    },
    "makedepends": {
      "description": "Build-time dependencies",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([><=]+[a-zA-Z0-9.:+~-]+)?$"
      },
      "uniqueItems": true
    },
    "checkdepends": {
      "description": "Dependencies needed for running tests",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([><=]+[a-zA-Z0-9.:+~-]+)?$"
      },
      "uniqueItems": true
    },
    "optdepends": {
      "description": "Optional dependencies that provide additional functionality",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([><=]+[a-zA-Z0-9.:+~-]+)?: .+$"
      },
      "uniqueItems": true
    },
    "provides": {
      "description": "Virtual packages that this package provides",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([>=]+[a-zA-Z0-9.:+~-]+)?$"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "description": "Packages that conflict with this package",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([><=]+[a-zA-Z0-9.:+~-]+)?$"
      },
      "uniqueItems": true
    },
    "replaces": {
      "description": "Packages that this package replaces",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@._+-]+([><=]+[a-zA-Z0-9.:+~-]+)?$"
      },
      "uniqueItems": true
    },
    "backup": {
      "description": "Configuration files that should be backed up",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/].*$"
      },
      "uniqueItems": true
    },
    "options": {
      "description": "Override default makepkg behavior",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "strip", "!strip",
          "docs", "!docs", 
          "libtool", "!libtool",
          "staticlibs", "!staticlibs",
          "emptydirs", "!emptydirs",
          "zipman", "!zipman",
          "purge", "!purge",
          "upx", "!upx",
          "debug", "!debug",
          "lto", "!lto"
        ]
      },
      "uniqueItems": true
    },
    "install": {
      "description": "Install script filename",
      "type": "string",
      "pattern": "^[^/]+\\.install$"
    },
    "changelog": {
      "description": "Changelog filename",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "description": "Source files and URLs",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_x86_64": {
      "description": "Source files specific to x86_64 architecture",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_i686": {
      "description": "Source files specific to i686 architecture", 
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validpgpkeys": {
      "description": "PGP key IDs for signature verification",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-F0-9]{40}$"
      },
      "uniqueItems": true
    },
    "noextract": {
      "description": "Files that should not be extracted",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checksums": {
      "description": "Integrity checksums",
      "type": "object",
      "properties": {
        "md5sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        },
        "sha1sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        },
        "sha224sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{56}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        },
        "sha256sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        },
        "sha384sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string", 
                "pattern": "^[a-f0-9]{96}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        },
        "sha512sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{128}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        },
        "b2sums": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{128}$"
              },
              {
                "type": "string",
                "enum": ["SKIP"]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "functions": {
      "description": "PKGBUILD functions",
      "type": "object",
      "properties": {
        "pkgver": {
          "description": "Dynamic version function",
          "type": "string"
        },
        "prepare": {
          "description": "Preparation function",
          "type": "string"
        },
        "build": {
          "description": "Build function",
          "type": "string"
        },
        "check": {
          "description": "Test function",
          "type": "string"
        },
        "package": {
          "description": "Package function",
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "metadata": {
      "description": "Additional metadata",
      "type": "object",
      "properties": {
        "maintainer": {
          "type": "string"
        },
        "contributor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "builddate": {
          "type": "string",
          "format": "date-time"
        },
        "packager": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "required": ["pkgname", "pkgver", "pkgrel", "arch"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "pkgname": {
            "type": "array"
          }
        }
      },
      "then": {
        "required": ["pkgbase"]
      }
    }
  ],
  "examples": [
    {
      "pkgname": "example-package",
      "pkgver": "1.0.0",
      "pkgrel": 1,
      "pkgdesc": "An example package for demonstration",
      "arch": ["any"],
      "url": "https://example.com",
      "license": ["MIT"],
      "depends": ["bash"],
      "source": ["example-1.0.0.tar.gz"],
      "checksums": {
        "sha256sums": ["e258d248fda94c63753607f7c4494ee0fcbe92f1a76bfdac795c9d84101eb317"]
      },
      "functions": {
        "package": "install -Dm755 example \"$pkgdir/usr/bin/example\""
      }
    }
  ]
}