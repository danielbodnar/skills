{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ast-grep Rule Schema",
  "description": "Schema for ast-grep rule files",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the rule",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "language": {
      "type": "string",
      "description": "Target programming language",
      "enum": [
        "javascript", "typescript", "tsx", "jsx",
        "python", "rust", "go", "java", "c", "cpp",
        "csharp", "php", "ruby", "swift", "kotlin",
        "dart", "lua", "bash", "html", "css", "json",
        "yaml", "xml", "sql", "graphql"
      ]
    },
    "rule": {
      "$ref": "#/$defs/rule",
      "description": "The rule object specifying match criteria"
    },
    "constraints": {
      "type": "object",
      "description": "Additional constraints on meta-variables",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "regex": {
            "type": "string",
            "description": "Regular expression constraint"
          },
          "kind": {
            "type": "string",
            "description": "AST node kind constraint"
          }
        },
        "additionalProperties": false
      }
    },
    "transform": {
      "type": "object",
      "description": "Transform meta-variables before fixing",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "String-style transformation"
          },
          {
            "type": "object",
            "properties": {
              "substring": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Source meta-variable"
                  },
                  "startChar": {
                    "type": "integer",
                    "description": "Start character index"
                  },
                  "endChar": {
                    "type": "integer",
                    "description": "End character index"
                  }
                },
                "required": ["source"],
                "additionalProperties": false
              },
              "replace": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Source meta-variable"
                  },
                  "replace": {
                    "type": "string",
                    "description": "Pattern to replace"
                  },
                  "by": {
                    "type": "string",
                    "description": "Replacement text"
                  }
                },
                "required": ["source", "replace", "by"],
                "additionalProperties": false
              },
              "convert": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Source meta-variable"
                  },
                  "toCase": {
                    "type": "string",
                    "enum": ["camelCase", "PascalCase", "snake_case", "kebab-case", "UPPER_CASE"],
                    "description": "Target case format"
                  }
                },
                "required": ["source", "toCase"],
                "additionalProperties": false
              },
              "rewrite": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Source meta-variable"
                  },
                  "rewriters": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of rewriter IDs to apply"
                  },
                  "joinBy": {
                    "type": "string",
                    "description": "String to join rewritten elements",
                    "default": ""
                  }
                },
                "required": ["source", "rewriters"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "rewriters": {
      "type": "array",
      "description": "Rewriter rules for complex transformations",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the rewriter"
          },
          "rule": {
            "$ref": "#/$defs/rule",
            "description": "Rule to match elements for rewriting"
          },
          "fix": {
            "type": "string",
            "description": "Fix template for rewriting"
          },
          "transform": {
            "$ref": "#/properties/transform",
            "description": "Transformations for this rewriter"
          },
          "constraints": {
            "$ref": "#/properties/constraints",
            "description": "Constraints for this rewriter"
          },
          "utils": {
            "$ref": "#/properties/utils",
            "description": "Utility rules for this rewriter"
          }
        },
        "required": ["id", "rule", "fix"],
        "additionalProperties": false
      }
    },
    "utils": {
      "type": "object",
      "description": "Utility rules for reuse within this rule file",
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    },
    "fix": {
      "type": "string",
      "description": "Template for automatic code fixing"
    },
    "message": {
      "type": "string",
      "description": "Human-readable message describing the issue"
    },
    "note": {
      "type": "string",
      "description": "Detailed explanation or rationale"
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info", "hint", "off"],
      "description": "Severity level of the rule violation",
      "default": "error"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL to documentation about this rule"
    },
    "labels": {
      "type": "object",
      "description": "Custom labels for highlighting specific parts",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "enum": ["primary", "secondary"],
            "description": "Highlighting style"
          },
          "message": {
            "type": "string",
            "description": "Label-specific message"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for external tools",
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "description": "File patterns to include",
      "items": {
        "type": "string",
        "description": "Glob pattern for file inclusion"
      }
    },
    "ignores": {
      "type": "array",
      "description": "File patterns to exclude",
      "items": {
        "type": "string",
        "description": "Glob pattern for file exclusion"
      }
    }
  },
  "required": ["id", "rule"],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "pattern": {
          "oneOf": [
            {
              "type": "string",
              "description": "Pattern string to match"
            },
            {
              "type": "object",
              "properties": {
                "context": {
                  "type": "string",
                  "description": "Context code for pattern parsing"
                },
                "selector": {
                  "type": "string",
                  "description": "AST node selector"
                },
                "strictness": {
                  "type": "string",
                  "enum": ["cst", "smart", "ast", "relaxed"],
                  "description": "Matching strictness level"
                }
              },
              "required": ["context"],
              "additionalProperties": false
            }
          ]
        },
        "kind": {
          "type": "string",
          "description": "AST node kind to match"
        },
        "regex": {
          "type": "string",
          "description": "Regular expression pattern"
        },
        "inside": {
          "allOf": [
            { "$ref": "#/$defs/rule" },
            {
              "properties": {
                "stopBy": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["end", "neighbor"],
                      "description": "Stop condition"
                    },
                    {
                      "$ref": "#/$defs/rule",
                      "description": "Rule-based stop condition"
                    }
                  ]
                },
                "field": {
                  "type": "string",
                  "description": "Semantic field to match"
                }
              }
            }
          ],
          "description": "Rule for containing node"
        },
        "has": {
          "allOf": [
            { "$ref": "#/$defs/rule" },
            {
              "properties": {
                "stopBy": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["end", "neighbor"],
                      "description": "Stop condition"
                    },
                    {
                      "$ref": "#/$defs/rule",
                      "description": "Rule-based stop condition"
                    }
                  ]
                },
                "field": {
                  "type": "string",
                  "description": "Semantic field to match"
                }
              }
            }
          ],
          "description": "Rule for descendant node"
        },
        "follows": {
          "allOf": [
            { "$ref": "#/$defs/rule" },
            {
              "properties": {
                "stopBy": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["end", "neighbor"],
                      "description": "Stop condition"
                    },
                    {
                      "$ref": "#/$defs/rule",
                      "description": "Rule-based stop condition"
                    }
                  ]
                }
              }
            }
          ],
          "description": "Rule for preceding sibling"
        },
        "precedes": {
          "allOf": [
            { "$ref": "#/$defs/rule" },
            {
              "properties": {
                "stopBy": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["end", "neighbor"],
                      "description": "Stop condition"
                    },
                    {
                      "$ref": "#/$defs/rule",
                      "description": "Rule-based stop condition"
                    }
                  ]
                }
              }
            }
          ],
          "description": "Rule for following sibling"
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "description": "All sub-rules must match"
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "description": "At least one sub-rule must match"
        },
        "not": {
          "$ref": "#/$defs/rule",
          "description": "Sub-rule must not match"
        },
        "matches": {
          "type": "string",
          "description": "Reference to utility rule"
        },
        "nthChild": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Exact child position"
            },
            {
              "type": "string",
              "pattern": "^\\d*n(\\+\\d+)?$",
              "description": "An+B notation"
            },
            {
              "type": "object",
              "properties": {
                "position": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d*n(\\+\\d+)?$"
                    }
                  ]
                },
                "reverse": {
                  "type": "boolean",
                  "default": false
                },
                "ofRule": {
                  "$ref": "#/$defs/rule"
                }
              },
              "required": ["position"],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}