{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ast-grep Configuration Schema",
  "description": "Schema for sgconfig.yml - ast-grep project configuration",
  "type": "object",
  "properties": {
    "ruleDirs": {
      "description": "List of directories containing ast-grep rules",
      "type": "array",
      "items": {
        "type": "string",
        "description": "Path to directory containing rule files"
      },
      "minItems": 1
    },
    "testConfigs": {
      "description": "Configuration for rule testing",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "testDir": {
            "type": "string",
            "description": "Directory containing test cases"
          },
          "snapshotDir": {
            "type": "string",
            "description": "Directory for test snapshots",
            "default": "__snapshots__"
          }
        },
        "required": ["testDir"],
        "additionalProperties": false
      }
    },
    "utilDirs": {
      "description": "List of directories containing utility rules",
      "type": "array",
      "items": {
        "type": "string",
        "description": "Path to directory containing utility rule files"
      }
    },
    "languageGlobs": {
      "description": "Custom file extension mappings for languages",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "Glob pattern for file matching"
        }
      }
    },
    "languageInjections": {
      "description": "Language injection configurations",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostLanguage": {
            "type": "string",
            "description": "Host language for injection"
          },
          "injected": {
            "type": "string",
            "description": "Injected language"
          },
          "rule": {
            "$ref": "#/$defs/rule",
            "description": "Rule to identify injection points"
          }
        },
        "required": ["hostLanguage", "injected", "rule"],
        "additionalProperties": false
      }
    }
  },
  "required": ["ruleDirs"],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "pattern": {
          "oneOf": [
            {
              "type": "string",
              "description": "Pattern string to match"
            },
            {
              "type": "object",
              "properties": {
                "context": {
                  "type": "string",
                  "description": "Context code for pattern parsing"
                },
                "selector": {
                  "type": "string",
                  "description": "AST node selector"
                },
                "strictness": {
                  "type": "string",
                  "enum": ["cst", "smart", "ast", "relaxed"],
                  "description": "Matching strictness level"
                }
              },
              "required": ["context"],
              "additionalProperties": false
            }
          ]
        },
        "kind": {
          "type": "string",
          "description": "AST node kind to match"
        },
        "regex": {
          "type": "string",
          "description": "Regular expression pattern"
        },
        "inside": {
          "$ref": "#/$defs/rule",
          "description": "Rule for containing node"
        },
        "has": {
          "$ref": "#/$defs/rule",
          "description": "Rule for descendant node"
        },
        "follows": {
          "$ref": "#/$defs/rule",
          "description": "Rule for preceding sibling"
        },
        "precedes": {
          "$ref": "#/$defs/rule",
          "description": "Rule for following sibling"
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "description": "All sub-rules must match"
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "description": "At least one sub-rule must match"
        },
        "not": {
          "$ref": "#/$defs/rule",
          "description": "Sub-rule must not match"
        },
        "matches": {
          "type": "string",
          "description": "Reference to utility rule"
        },
        "field": {
          "type": "string",
          "description": "Semantic field to match"
        },
        "stopBy": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["end", "neighbor"],
              "description": "Stop condition"
            },
            {
              "$ref": "#/$defs/rule",
              "description": "Rule-based stop condition"
            }
          ]
        },
        "nthChild": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Exact child position"
            },
            {
              "type": "string",
              "pattern": "^\\d*n(\\+\\d+)?$",
              "description": "An+B notation"
            },
            {
              "type": "object",
              "properties": {
                "position": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d*n(\\+\\d+)?$"
                    }
                  ]
                },
                "reverse": {
                  "type": "boolean",
                  "default": false
                },
                "ofRule": {
                  "$ref": "#/$defs/rule"
                }
              },
              "required": ["position"],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}