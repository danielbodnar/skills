# VyOS WireGuard VPN Configuration

configure

# Generate WireGuard keys (run in operational mode first)
# run generate pki wireguard key-pair install interface wg01

# WireGuard interface configuration
set interfaces wireguard wg01 address '10.0.0.1/24'
set interfaces wireguard wg01 description 'WireGuard VPN Interface'
set interfaces wireguard wg01 port '51820'

# Private key (generated above)
set interfaces wireguard wg01 private-key 'default'

# Peer configuration
set interfaces wireguard wg01 peer client1 address '10.0.0.2/32'
set interfaces wireguard wg01 peer client1 allowed-ips '10.0.0.2/32'
set interfaces wireguard wg01 peer client1 public-key 'client1-public-key-here'
set interfaces wireguard wg01 peer client1 persistent-keepalive '25'

set interfaces wireguard wg01 peer client2 address '10.0.0.3/32'
set interfaces wireguard wg01 peer client2 allowed-ips '10.0.0.3/32'
set interfaces wireguard wg01 peer client2 public-key 'client2-public-key-here'
set interfaces wireguard wg01 peer client2 persistent-keepalive '25'

# Firewall rules for WireGuard
set firewall name OUTSIDE-IN rule 200 action 'accept'
set firewall name OUTSIDE-IN rule 200 description 'Allow WireGuard'
set firewall name OUTSIDE-IN rule 200 destination port '51820'
set firewall name OUTSIDE-IN rule 200 protocol 'udp'

# NAT configuration for VPN clients
set nat source rule 200 outbound-interface 'eth1'
set nat source rule 200 source address '10.0.0.0/24'
set nat source rule 200 translation address 'masquerade'

# Routing for VPN clients to access LAN
set protocols static route 10.0.0.0/24 interface wg01

# Optional: DNS for VPN clients
set service dns forwarding listen-address '10.0.0.1'
set service dns forwarding allow-from '10.0.0.0/24'

commit
save
exit

# Client configuration example (to be used on client devices):
# [Interface]
# PrivateKey = client1-private-key-here
# Address = 10.0.0.2/24
# DNS = 10.0.0.1
# 
# [Peer]
# PublicKey = server-public-key-here
# Endpoint = server-public-ip:51820
# AllowedIPs = 0.0.0.0/0
# PersistentKeepalive = 25