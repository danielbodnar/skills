# VyOS BGP Basic Configuration

configure

# Configure BGP router
set protocols bgp system-as '65001'
set protocols bgp router-id '10.0.0.1'

# BGP neighbor configuration
set protocols bgp neighbor 10.0.0.2 remote-as '65002'
set protocols bgp neighbor 10.0.0.2 description 'Peer Router'
set protocols bgp neighbor 10.0.0.2 update-source '10.0.0.1'

# Network advertisement
set protocols bgp address-family ipv4-unicast network 192.168.1.0/24
set protocols bgp address-family ipv4-unicast network 192.168.2.0/24

# BGP route filtering
set policy route-map FILTER-OUT rule 10 action 'permit'
set policy route-map FILTER-OUT rule 10 match ip address prefix-list 'ALLOWED-NETWORKS'
set policy route-map FILTER-OUT rule 20 action 'deny'

# Prefix list for route filtering
set policy prefix-list ALLOWED-NETWORKS rule 10 action 'permit'
set policy prefix-list ALLOWED-NETWORKS rule 10 prefix '192.168.1.0/24'
set policy prefix-list ALLOWED-NETWORKS rule 20 action 'permit'
set policy prefix-list ALLOWED-NETWORKS rule 20 prefix '192.168.2.0/24'

# Apply route-map to neighbor
set protocols bgp neighbor 10.0.0.2 address-family ipv4-unicast route-map export 'FILTER-OUT'

# BGP timers
set protocols bgp neighbor 10.0.0.2 timers holdtime '180'
set protocols bgp neighbor 10.0.0.2 timers keepalive '60'

# Enable BGP logging
set protocols bgp parameters log-neighbor-changes

commit
save
exit