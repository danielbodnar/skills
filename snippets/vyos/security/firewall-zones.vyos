# VyOS Zone-Based Firewall Configuration

configure

# Define security zones
set firewall zone LAN description 'Internal LAN Zone'
set firewall zone LAN interface 'eth0'
set firewall zone LAN default-action 'drop'

set firewall zone WAN description 'External WAN Zone'
set firewall zone WAN interface 'eth1'
set firewall zone WAN default-action 'drop'

set firewall zone DMZ description 'DMZ Zone'
set firewall zone DMZ interface 'eth2'
set firewall zone DMZ default-action 'drop'

set firewall zone LOCAL description 'Local Router Zone'
set firewall zone LOCAL local-zone
set firewall zone LOCAL default-action 'drop'

# Inter-zone policies
# LAN to WAN (allow outbound internet)
set firewall zone LAN from WAN firewall name 'LAN-WAN'
set firewall name LAN-WAN default-action 'accept'

# WAN to LAN (deny inbound, allow established)
set firewall zone WAN from LAN firewall name 'WAN-LAN'
set firewall name WAN-LAN default-action 'drop'
set firewall name WAN-LAN rule 10 action 'accept'
set firewall name WAN-LAN rule 10 state established 'enable'
set firewall name WAN-LAN rule 10 state related 'enable'

# LAN to LOCAL (allow management)
set firewall zone LAN from LOCAL firewall name 'LAN-LOCAL'
set firewall name LAN-LOCAL default-action 'accept'

# LOCAL to LAN (allow responses)
set firewall zone LOCAL from LAN firewall name 'LOCAL-LAN'
set firewall name LOCAL-LAN default-action 'accept'

# WAN to LOCAL (limited management)
set firewall zone WAN from LOCAL firewall name 'WAN-LOCAL'
set firewall name WAN-LOCAL default-action 'drop'
set firewall name WAN-LOCAL rule 10 action 'accept'
set firewall name WAN-LOCAL rule 10 state established 'enable'
set firewall name WAN-LOCAL rule 10 state related 'enable'
set firewall name WAN-LOCAL rule 20 action 'accept'
set firewall name WAN-LOCAL rule 20 destination port '22'
set firewall name WAN-LOCAL rule 20 protocol 'tcp'
set firewall name WAN-LOCAL rule 20 source address '192.168.100.0/24'

# LOCAL to WAN (allow router internet access)
set firewall zone LOCAL from WAN firewall name 'LOCAL-WAN'
set firewall name LOCAL-WAN default-action 'accept'

# DMZ rules
# LAN to DMZ (allow access to DMZ services)
set firewall zone LAN from DMZ firewall name 'LAN-DMZ'
set firewall name LAN-DMZ default-action 'accept'

# DMZ to LAN (deny access to internal network)
set firewall zone DMZ from LAN firewall name 'DMZ-LAN'
set firewall name DMZ-LAN default-action 'drop'

# WAN to DMZ (allow specific services)
set firewall zone WAN from DMZ firewall name 'WAN-DMZ'
set firewall name WAN-DMZ default-action 'drop'
set firewall name WAN-DMZ rule 10 action 'accept'
set firewall name WAN-DMZ rule 10 destination port '80'
set firewall name WAN-DMZ rule 10 protocol 'tcp'
set firewall name WAN-DMZ rule 20 action 'accept'
set firewall name WAN-DMZ rule 20 destination port '443'
set firewall name WAN-DMZ rule 20 protocol 'tcp'

# DMZ to WAN (allow outbound for updates)
set firewall zone DMZ from WAN firewall name 'DMZ-WAN'
set firewall name DMZ-WAN default-action 'drop'
set firewall name DMZ-WAN rule 10 action 'accept'
set firewall name DMZ-WAN rule 10 state established 'enable'
set firewall name DMZ-WAN rule 10 state related 'enable'

commit
save
exit