# VyOS L3VPN EVPN Configuration Blueprint
# Based on VyOS documentation autotest examples
# Implements EVPN L3VPN with VXLAN overlay

# PE Router 1 Configuration
configure

# System configuration
set system host-name 'PE1'
set system domain-name 'evpn.lab'

# Loopback interface for BGP router ID and VTEP
set interfaces loopback lo address '10.255.255.1/32'

# Physical interfaces
set interfaces ethernet eth0 address '192.168.1.1/24'
set interfaces ethernet eth0 description 'Customer Blue Site 1'
set interfaces ethernet eth1 address '10.0.12.1/30'
set interfaces ethernet eth1 description 'P2P to PE2'
set interfaces ethernet eth2 address '10.0.13.1/30'
set interfaces ethernet eth2 description 'P2P to PE3'

# VRF Configuration for L3VPN
set vrf name BLUE table '2000'
set vrf name BLUE vni '2000'
set vrf name RED table '3000'
set vrf name RED vni '3000'
set vrf name GREEN table '4000'
set vrf name GREEN vni '4000'

# Assign customer interfaces to VRFs
set interfaces ethernet eth0 vrf 'BLUE'

# VXLAN Interfaces for EVPN
set interfaces vxlan vxlan2000 source-address '10.255.255.1'
set interfaces vxlan vxlan2000 vni '2000'
set interfaces vxlan vxlan2000 parameters nolearning

set interfaces vxlan vxlan3000 source-address '10.255.255.1'
set interfaces vxlan vxlan3000 vni '3000'
set interfaces vxlan vxlan3000 parameters nolearning

set interfaces vxlan vxlan4000 source-address '10.255.255.1'
set interfaces vxlan vxlan4000 vni '4000'
set interfaces vxlan vxlan4000 parameters nolearning

# OSPF for underlay reachability
set protocols ospf router-id '10.255.255.1'
set protocols ospf area 0 network '10.0.0.0/8'
set protocols ospf area 0 network '10.255.255.1/32'
set protocols ospf log-adjacency-changes

# BGP Configuration for EVPN
set protocols bgp system-as '65000'
set protocols bgp router-id '10.255.255.1'

# iBGP peers for EVPN
set protocols bgp neighbor 10.255.255.2 remote-as '65000'
set protocols bgp neighbor 10.255.255.2 description 'PE2 EVPN peer'
set protocols bgp neighbor 10.255.255.2 update-source 'loopback'
set protocols bgp neighbor 10.255.255.2 address-family l2vpn-evpn activate

set protocols bgp neighbor 10.255.255.3 remote-as '65000'
set protocols bgp neighbor 10.255.255.3 description 'PE3 EVPN peer'
set protocols bgp neighbor 10.255.255.3 update-source 'loopback'
set protocols bgp neighbor 10.255.255.3 address-family l2vpn-evpn activate

# EVPN VNI configuration
set protocols bgp address-family l2vpn-evpn vni 2000 advertise-default-gw
set protocols bgp address-family l2vpn-evpn vni 2000 advertise-svi-ip
set protocols bgp address-family l2vpn-evpn vni 2000 rd '65000:2000'
set protocols bgp address-family l2vpn-evpn vni 2000 route-target export '65000:2000'
set protocols bgp address-family l2vpn-evpn vni 2000 route-target import '65000:2000'

set protocols bgp address-family l2vpn-evpn vni 3000 advertise-default-gw
set protocols bgp address-family l2vpn-evpn vni 3000 advertise-svi-ip
set protocols bgp address-family l2vpn-evpn vni 3000 rd '65000:3000'
set protocols bgp address-family l2vpn-evpn vni 3000 route-target export '65000:3000'
set protocols bgp address-family l2vpn-evpn vni 3000 route-target import '65000:3000'

set protocols bgp address-family l2vpn-evpn vni 4000 advertise-default-gw
set protocols bgp address-family l2vpn-evpn vni 4000 advertise-svi-ip
set protocols bgp address-family l2vpn-evpn vni 4000 rd '65000:4000'
set protocols bgp address-family l2vpn-evpn vni 4000 route-target export '65000:4000'
set protocols bgp address-family l2vpn-evpn vni 4000 route-target import '65000:4000'

# VRF BGP configuration for customer routes
set protocols bgp vrf BLUE autonomous-system '65000'
set protocols bgp vrf BLUE router-id '10.255.255.1'
set protocols bgp vrf BLUE rd '65000:2000'
set protocols bgp vrf BLUE route-target export '65000:2000'
set protocols bgp vrf BLUE route-target import '65000:2000'
set protocols bgp vrf BLUE address-family ipv4-unicast redistribute connected

set protocols bgp vrf RED autonomous-system '65000'
set protocols bgp vrf RED router-id '10.255.255.1'
set protocols bgp vrf RED rd '65000:3000'
set protocols bgp vrf RED route-target export '65000:3000'
set protocols bgp vrf RED route-target import '65000:3000'
set protocols bgp vrf RED address-family ipv4-unicast redistribute connected

set protocols bgp vrf GREEN autonomous-system '65000'
set protocols bgp vrf GREEN router-id '10.255.255.1'
set protocols bgp vrf GREEN rd '65000:4000'
set protocols bgp vrf GREEN route-target export '65000:4000'
set protocols bgp vrf GREEN route-target import '65000:4000'
set protocols bgp vrf GREEN address-family ipv4-unicast redistribute connected

# Bridge interfaces for L3 SVI
set interfaces bridge br2000 member interface vxlan2000
set interfaces bridge br2000 vrf 'BLUE'
set interfaces bridge br2000 address '192.168.100.1/24'

set interfaces bridge br3000 member interface vxlan3000
set interfaces bridge br3000 vrf 'RED'
set interfaces bridge br3000 address '192.168.200.1/24'

set interfaces bridge br4000 member interface vxlan4000
set interfaces bridge br4000 vrf 'GREEN'
set interfaces bridge br4000 address '192.168.300.1/24'

commit
save
exit

# ================================================================
# PE Router 2 Configuration (similar structure)
# ================================================================

configure

# System configuration
set system host-name 'PE2'
set system domain-name 'evpn.lab'

# Loopback interface
set interfaces loopback lo address '10.255.255.2/32'

# Physical interfaces
set interfaces ethernet eth0 address '192.168.2.1/24'
set interfaces ethernet eth0 description 'Customer Blue Site 2'
set interfaces ethernet eth1 address '10.0.12.2/30'
set interfaces ethernet eth1 description 'P2P to PE1'
set interfaces ethernet eth2 address '10.0.23.1/30'
set interfaces ethernet eth2 description 'P2P to PE3'

# VRF Configuration
set vrf name BLUE table '2000'
set vrf name BLUE vni '2000'
set vrf name RED table '3000'
set vrf name RED vni '3000'
set vrf name GREEN table '4000'
set vrf name GREEN vni '4000'

# Assign customer interfaces to VRFs
set interfaces ethernet eth0 vrf 'BLUE'

# VXLAN Interfaces
set interfaces vxlan vxlan2000 source-address '10.255.255.2'
set interfaces vxlan vxlan2000 vni '2000'
set interfaces vxlan vxlan2000 parameters nolearning

set interfaces vxlan vxlan3000 source-address '10.255.255.2'
set interfaces vxlan vxlan3000 vni '3000'
set interfaces vxlan vxlan3000 parameters nolearning

set interfaces vxlan vxlan4000 source-address '10.255.255.2'
set interfaces vxlan vxlan4000 vni '4000'
set interfaces vxlan vxlan4000 parameters nolearning

# OSPF Configuration
set protocols ospf router-id '10.255.255.2'
set protocols ospf area 0 network '10.0.0.0/8'
set protocols ospf area 0 network '10.255.255.2/32'
set protocols ospf log-adjacency-changes

# BGP Configuration
set protocols bgp system-as '65000'
set protocols bgp router-id '10.255.255.2'

# iBGP peers
set protocols bgp neighbor 10.255.255.1 remote-as '65000'
set protocols bgp neighbor 10.255.255.1 description 'PE1 EVPN peer'
set protocols bgp neighbor 10.255.255.1 update-source 'loopback'
set protocols bgp neighbor 10.255.255.1 address-family l2vpn-evpn activate

set protocols bgp neighbor 10.255.255.3 remote-as '65000'
set protocols bgp neighbor 10.255.255.3 description 'PE3 EVPN peer'
set protocols bgp neighbor 10.255.255.3 update-source 'loopback'
set protocols bgp neighbor 10.255.255.3 address-family l2vpn-evpn activate

# EVPN VNI configuration (same as PE1)
set protocols bgp address-family l2vpn-evpn vni 2000 advertise-default-gw
set protocols bgp address-family l2vpn-evpn vni 2000 advertise-svi-ip
set protocols bgp address-family l2vpn-evpn vni 2000 rd '65000:2000'
set protocols bgp address-family l2vpn-evpn vni 2000 route-target export '65000:2000'
set protocols bgp address-family l2vpn-evpn vni 2000 route-target import '65000:2000'

set protocols bgp address-family l2vpn-evpn vni 3000 advertise-default-gw
set protocols bgp address-family l2vpn-evpn vni 3000 advertise-svi-ip
set protocols bgp address-family l2vpn-evpn vni 3000 rd '65000:3000'
set protocols bgp address-family l2vpn-evpn vni 3000 route-target export '65000:3000'
set protocols bgp address-family l2vpn-evpn vni 3000 route-target import '65000:3000'

set protocols bgp address-family l2vpn-evpn vni 4000 advertise-default-gw
set protocols bgp address-family l2vpn-evpn vni 4000 advertise-svi-ip
set protocols bgp address-family l2vpn-evpn vni 4000 rd '65000:4000'
set protocols bgp address-family l2vpn-evpn vni 4000 route-target export '65000:4000'
set protocols bgp address-family l2vpn-evpn vni 4000 route-target import '65000:4000'

# VRF BGP configuration
set protocols bgp vrf BLUE autonomous-system '65000'
set protocols bgp vrf BLUE router-id '10.255.255.2'
set protocols bgp vrf BLUE rd '65000:2000'
set protocols bgp vrf BLUE route-target export '65000:2000'
set protocols bgp vrf BLUE route-target import '65000:2000'
set protocols bgp vrf BLUE address-family ipv4-unicast redistribute connected

set protocols bgp vrf RED autonomous-system '65000'
set protocols bgp vrf RED router-id '10.255.255.2'
set protocols bgp vrf RED rd '65000:3000'
set protocols bgp vrf RED route-target export '65000:3000'
set protocols bgp vrf RED route-target import '65000:3000'
set protocols bgp vrf RED address-family ipv4-unicast redistribute connected

set protocols bgp vrf GREEN autonomous-system '65000'
set protocols bgp vrf GREEN router-id '10.255.255.2'
set protocols bgp vrf GREEN rd '65000:4000'
set protocols bgp vrf GREEN route-target export '65000:4000'
set protocols bgp vrf GREEN route-target import '65000:4000'
set protocols bgp vrf GREEN address-family ipv4-unicast redistribute connected

# Bridge interfaces
set interfaces bridge br2000 member interface vxlan2000
set interfaces bridge br2000 vrf 'BLUE'
set interfaces bridge br2000 address '192.168.100.2/24'

set interfaces bridge br3000 member interface vxlan3000
set interfaces bridge br3000 vrf 'RED'
set interfaces bridge br3000 address '192.168.200.2/24'

set interfaces bridge br4000 member interface vxlan4000
set interfaces bridge br4000 vrf 'GREEN'
set interfaces bridge br4000 address '192.168.300.2/24'

commit
save
exit

# ================================================================
# Verification Commands
# ================================================================

# Check EVPN routes
show bgp l2vpn evpn

# Check VRF routes
show ip route vrf BLUE
show ip route vrf RED
show ip route vrf GREEN

# Check VXLAN interfaces
show interfaces vxlan

# Check BGP EVPN neighbors
show bgp l2vpn evpn summary

# Check bridge interfaces
show interfaces bridge

# Check VNI information
show evpn vni

# Check MAC address table
show bridge

# Test connectivity between sites
ping 192.168.2.10 source-address 192.168.1.10 vrf BLUE

# ================================================================
# Troubleshooting Commands
# ================================================================

# Debug EVPN
debug bgp evpn

# Check EVPN type-2 routes
show bgp l2vpn evpn route type 2

# Check EVPN type-3 routes  
show bgp l2vpn evpn route type 3

# Check EVPN type-5 routes
show bgp l2vpn evpn route type 5

# Show VXLAN tunnel endpoints
show interfaces vxlan detail

# Show VRF routing tables
show ip route table 2000
show ip route table 3000
show ip route table 4000