{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "projectType": "openSource",
  "incremental": true,
  "typescript": {
    "quoteStyle": "double",
    "semiColons": "asi",
    "trailingComma": "es5",
    "indentWidth": 2,
    "lineWidth": 100,
    "useBraces": "whenNotSingleLine",
    "bracePosition": "sameLineUnlessHanging",
    "singleBodyPosition": "maintain",
    "nextControlFlowPosition": "nextLine",
    "conditionalExpression.linePerExpression": false,
    "conditionalType.linePerExpression": false,
    "enumDeclaration.memberSpacing": "maintain",
    "exportDeclaration.forceSingleLine": false,
    "importDeclaration.forceSingleLine": false,
    "jsx.quoteStyle": "double",
    "jsx.multiLineParens": "prefer",
    "memberExpression.linePerExpression": false,
    "objectExpression.spaceSurroundingProperties": true,
    "objectPattern.spaceSurroundingProperties": true,
    "typeAssertion.spaceSurroundingAngleBrackets": false,
    "typeLiteral.spaceSurroundingProperties": true,
    "variableStatement.preferSingleLine": false
  },
  "json": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "trailingCommas": "never"
  },
  "markdown": {
    "lineWidth": 100,
    "proseWrap": "always"
  },
  "toml": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false
  },
  "dockerfile": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false
  },
  "yaml": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false
  },
  "includes": [
    "**/*.{ts,tsx,js,jsx,mjs,cjs}",
    "**/*.{json,jsonc}",
    "**/*.{md,mdx}",
    "**/*.{yml,yaml}",
    "**/*.toml",
    "**/Dockerfile*",
    "**/.dockerignore"
  ],
  "excludes": [
    "node_modules",
    "dist",
    "build",
    ".next",
    ".nuxt",
    ".output",
    ".vercel",
    ".netlify",
    "coverage",
    "*.min.js",
    "*.min.css",
    "*.generated.*",
    "**/.git/**",
    "**/target/**",
    "**/Cargo.lock",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/bun.lockb"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.91.1.wasm",
    "https://plugins.dprint.dev/json-0.19.3.wasm",
    "https://plugins.dprint.dev/markdown-0.17.2.wasm",
    "https://plugins.dprint.dev/toml-0.6.2.wasm",
    "https://plugins.dprint.dev/dockerfile-0.3.2.wasm",
    "https://plugins.dprint.dev/yaml-0.1.1.wasm"
  ]
}