{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goose Recipe Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the recipe"
    },
    "description": {
      "type": "string",
      "description": "A description of what the recipe does"
    },
    "version": {
      "type": "string",
      "description": "The version of the recipe"
    },
    "extensions": {
      "type": "array",
      "description": "Extensions to be configured for this recipe",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["stdio", "remote", "builtin"],
            "description": "The type of extension"
          },
          "name": {
            "type": "string",
            "description": "The name of the extension"
          },
          "cmd": {
            "type": "string",
            "description": "The command to execute"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments to pass to the command"
          },
          "timeout": {
            "type": "integer",
            "default": 300,
            "description": "Timeout in seconds"
          },
          "bundled": {
            "type": "boolean",
            "default": false,
            "description": "Whether the extension is bundled with the recipe"
          },
          "description": {
            "type": "string",
            "description": "A description of what the extension does"
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment variables for the extension"
          }
        },
        "required": ["type", "name"]
      }
    },
    "prompts": {
      "type": "array",
      "description": "Predefined prompts for the recipe",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the prompt"
          },
          "description": {
            "type": "string",
            "description": "A description of what the prompt does"
          },
          "content": {
            "type": "string",
            "description": "The prompt content"
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Variables that can be substituted in the prompt"
          }
        },
        "required": ["name", "content"]
      }
    },
    "models": {
      "type": "object",
      "description": "Recommended models for different roles",
      "properties": {
        "main": {
          "type": "string",
          "description": "Main conversational model"
        },
        "lead": {
          "type": "string",
          "description": "Lead model for complex tasks"
        },
        "planner": {
          "type": "string",
          "description": "Planning model"
        },
        "editor": {
          "type": "string",
          "description": "AI editor model"
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "description": "Prerequisites for using this recipe",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["tool", "service", "environment", "api_key"],
            "description": "The type of prerequisite"
          },
          "name": {
            "type": "string",
            "description": "The name of the prerequisite"
          },
          "description": {
            "type": "string",
            "description": "A description of the prerequisite"
          },
          "installation": {
            "type": "string",
            "description": "How to install or set up the prerequisite"
          },
          "validation": {
            "type": "string",
            "description": "How to validate the prerequisite is set up correctly"
          }
        },
        "required": ["type", "name"]
      }
    }
  },
  "required": ["name", "description", "version"]
}