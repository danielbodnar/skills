{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goose Configuration Schema",
  "type": "object",
  "properties": {
    "providers": {
      "type": "object",
      "description": "LLM provider configurations",
      "properties": {
        "openai": {
          "type": "object",
          "properties": {
            "api_key": { "type": "string" },
            "host": { "type": "string", "default": "https://api.openai.com/v1" },
            "model": { "type": "string", "default": "gpt-4o" },
            "organization": { "type": "string" },
            "project": { "type": "string" },
            "custom_headers": { "type": "string" }
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "api_key": { "type": "string" },
            "host": { "type": "string", "default": "https://api.anthropic.com/v1" },
            "model": { "type": "string", "default": "claude-3-5-sonnet-latest" }
          }
        },
        "google": {
          "type": "object",
          "properties": {
            "api_key": { "type": "string" },
            "model": { "type": "string", "default": "gemini-2.0-flash-exp" }
          }
        },
        "databricks": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "api_key": { "type": "string" }
          }
        },
        "ollama": {
          "type": "object",
          "properties": {
            "host": { "type": "string", "default": "http://localhost:11434" },
            "model": { "type": "string" }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Model configuration for different modes",
      "properties": {
        "main": { "type": "string", "description": "Main conversational model" },
        "lead": { "type": "string", "description": "Lead model for complex tasks" },
        "planner": { "type": "string", "description": "Planning model" },
        "editor": { "type": "string", "description": "AI editor model" }
      }
    },
    "extensions": {
      "type": "array",
      "description": "Configured extensions",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["stdio", "remote", "builtin"] },
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "timeout": { "type": "integer", "default": 300 },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "bundled": { "type": "boolean", "default": false },
          "description": { "type": "string" }
        },
        "required": ["id", "name", "type"]
      }
    },
    "allowlist": {
      "type": "object",
      "description": "Extension allowlist configuration",
      "properties": {
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "command": { "type": "string" }
            },
            "required": ["id", "command"]
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "description": "AI editor configuration",
      "properties": {
        "api_key": { "type": "string" },
        "host": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "settings": {
      "type": "object",
      "description": "General settings",
      "properties": {
        "disable_keyring": { "type": "boolean", "default": false },
        "session_persistence": { "type": "boolean", "default": true },
        "permissions": {
          "type": "object",
          "properties": {
            "file_modification": { "type": "boolean", "default": true },
            "execution": { "type": "boolean", "default": true },
            "network": { "type": "boolean", "default": true }
          }
        }
      }
    }
  }
}