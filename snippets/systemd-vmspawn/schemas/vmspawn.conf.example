# systemd-vmspawn Configuration File Example
# Location: /etc/systemd/vmspawn/<name>.conf
# Used with: systemctl start systemd-vmspawn@<name>.service

[Spawn]
# Image or directory to use as root filesystem
# Use either Image= or Directory=, not both
Image=/var/lib/machines/example.raw
#Directory=/var/lib/machines/example-rootfs

# Machine name for the VM
# If not specified, uses the configuration file name
#Machine=example-vm

# Number of virtual CPUs (default: 1)
CPUs=2

# Memory allocation (default: 2G)
# Accepts units: K, M, G, T
Memory=4G

# Enable/disable KVM acceleration (default: yes if available)
KVM=yes

# Enable/disable software TPM (systemd 256+)
TPM=yes

# Secure Boot configuration (default: pick first available firmware)
# Options: yes, no, auto
SecureBoot=yes

# Firmware definition file path
# Use 'list' to see available firmware definitions
#Firmware=/usr/share/qemu/firmware/50-edk2-x86_64-secure.json

# Console mode configuration
# Options: interactive, read-only, native, gui
Console=interactive

# Terminal background color for identification
#Background=green

# Networking configuration
# Enable user-mode networking (no root required)
NetworkUserMode=yes

# Enable TAP networking (requires root and systemd-networkd)
#NetworkTap=yes

# VSock configuration
# Format: yes[,CID] where CID is 3-4294967294
VSock=yes,100

# SSH key management
# Generate ephemeral SSH keys for VM access
PassSSHKey=yes

# SSH key type: ed25519 or rsa
SSHKeyType=ed25519

# User namespace mapping (for unprivileged operation)
# Specify starting UID for mapping
#PrivateUsers=65536

# Register VM with systemd-machined
Register=yes

# Forward VM journal to host file
#ForwardJournal=/var/log/vm-example.journal

# Kernel and initrd for direct boot (systemd 256+)
#Linux=/boot/vmlinuz
#Initrd=/boot/initramfs.img

# Additional disk drives
# Can be specified multiple times
#ExtraDrive=/var/lib/machines/example-data.qcow2
#ExtraDrive=/var/lib/machines/example-logs.raw

# Bind mount host directories into VM
# Format: source[:target[:options]]
# Options: ro for read-only
#Bind=/home/shared:/mnt/shared
#Bind=/etc/ssl/certs:/etc/ssl/certs:ro

# Read-only bind mounts
#BindReadOnly=/usr/share/ca-certificates:/usr/share/ca-certificates

# Credential passing
# Pass host credentials to VM securely
#Credential=database-password:/run/secrets/db-password
#Credential=api-key:literal:secret-api-key-value

# Additional kernel command line parameters
# Appended when using direct kernel boot
#KernelCommandLine=console=ttyS0 systemd.unit=multi-user.target

# QEMU machine type (advanced users)
#QemuMachine=q35

# Additional QEMU arguments (use SYSTEMD_VMSPAWN_QEMU_EXTRA environment variable instead)
# This is not a configuration option but can be set via environment:
# SYSTEMD_VMSPAWN_QEMU_EXTRA="-device virtio-gpu-pci -display gtk"