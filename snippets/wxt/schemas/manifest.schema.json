{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web Extension Manifest Schema",
  "description": "Schema for web extension manifest.json files (MV2 and MV3)",
  "type": "object",
  "required": ["manifest_version", "name", "version"],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "description": "Manifest format version",
      "enum": [2, 3]
    },
    "name": {
      "type": "string",
      "description": "Extension name",
      "maxLength": 45
    },
    "version": {
      "type": "string",
      "description": "Extension version",
      "pattern": "^\\d+(\\.\\d+)*$"
    },
    "description": {
      "type": "string",
      "description": "Extension description",
      "maxLength": 132
    },
    "icons": {
      "type": "object",
      "description": "Extension icons",
      "additionalProperties": {
        "type": "string"
      }
    },
    "action": {
      "type": "object",
      "description": "Browser action (MV3)",
      "properties": {
        "default_popup": {
          "type": "string",
          "description": "Popup HTML file"
        },
        "default_title": {
          "type": "string",
          "description": "Default tooltip text"
        },
        "default_icon": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "browser_action": {
      "type": "object",
      "description": "Browser action (MV2)",
      "properties": {
        "default_popup": {
          "type": "string"
        },
        "default_title": {
          "type": "string"
        },
        "default_icon": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "page_action": {
      "type": "object",
      "description": "Page action (MV2)",
      "properties": {
        "default_popup": {
          "type": "string"
        },
        "default_title": {
          "type": "string"
        },
        "default_icon": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "background": {
      "type": "object",
      "description": "Background script configuration",
      "oneOf": [
        {
          "properties": {
            "service_worker": {
              "type": "string",
              "description": "Service worker file (MV3)"
            }
          },
          "required": ["service_worker"]
        },
        {
          "properties": {
            "scripts": {
              "type": "array",
              "description": "Background scripts (MV2)",
              "items": {
                "type": "string"
              }
            },
            "persistent": {
              "type": "boolean",
              "description": "Persistent background page"
            }
          },
          "required": ["scripts"]
        },
        {
          "properties": {
            "page": {
              "type": "string",
              "description": "Background page HTML"
            },
            "persistent": {
              "type": "boolean"
            }
          },
          "required": ["page"]
        }
      ]
    },
    "content_scripts": {
      "type": "array",
      "description": "Content scripts configuration",
      "items": {
        "type": "object",
        "required": ["matches"],
        "properties": {
          "matches": {
            "type": "array",
            "description": "URL patterns to match",
            "items": {
              "type": "string"
            }
          },
          "exclude_matches": {
            "type": "array",
            "description": "URL patterns to exclude",
            "items": {
              "type": "string"
            }
          },
          "include_globs": {
            "type": "array",
            "description": "Glob patterns to include",
            "items": {
              "type": "string"
            }
          },
          "exclude_globs": {
            "type": "array",
            "description": "Glob patterns to exclude",
            "items": {
              "type": "string"
            }
          },
          "js": {
            "type": "array",
            "description": "JavaScript files",
            "items": {
              "type": "string"
            }
          },
          "css": {
            "type": "array",
            "description": "CSS files",
            "items": {
              "type": "string"
            }
          },
          "run_at": {
            "type": "string",
            "description": "When to run the script",
            "enum": ["document_start", "document_end", "document_idle"],
            "default": "document_idle"
          },
          "all_frames": {
            "type": "boolean",
            "description": "Run in all frames"
          },
          "match_about_blank": {
            "type": "boolean",
            "description": "Match about:blank pages"
          },
          "world": {
            "type": "string",
            "description": "Execution world (MV3)",
            "enum": ["ISOLATED", "MAIN"]
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "description": "Extension permissions",
      "items": {
        "type": "string",
        "enum": [
          "activeTab",
          "alarms",
          "background",
          "bookmarks",
          "browsingData",
          "certificateProvider",
          "clipboardRead",
          "clipboardWrite",
          "contentSettings",
          "contextMenus",
          "cookies",
          "debugger",
          "declarativeContent",
          "declarativeNetRequest",
          "declarativeNetRequestFeedback",
          "declarativeNetRequestWithHostAccess",
          "declarativeWebRequest",
          "desktopCapture",
          "documentScan",
          "downloads",
          "enterprise.deviceAttributes",
          "enterprise.hardwarePlatform",
          "enterprise.machineId",
          "enterprise.platformKeys",
          "experimental",
          "fileBrowserHandler",
          "fileSystemProvider",
          "fontSettings",
          "gcm",
          "geolocation",
          "history",
          "identity",
          "idle",
          "loginState",
          "management",
          "nativeMessaging",
          "notifications",
          "offscreen",
          "pageCapture",
          "platformKeys",
          "power",
          "printerProvider",
          "privacy",
          "proxy",
          "scripting",
          "search",
          "sessions",
          "sidePanel",
          "storage",
          "system.cpu",
          "system.display",
          "system.memory",
          "system.storage",
          "tabCapture",
          "tabGroups",
          "tabs",
          "topSites",
          "tts",
          "ttsEngine",
          "unlimitedStorage",
          "vpnProvider",
          "wallpaper",
          "webAuthenticationProxy",
          "webNavigation",
          "webRequest",
          "webRequestBlocking"
        ]
      }
    },
    "host_permissions": {
      "type": "array",
      "description": "Host permissions (MV3)",
      "items": {
        "type": "string"
      }
    },
    "optional_permissions": {
      "type": "array",
      "description": "Optional permissions",
      "items": {
        "type": "string"
      }
    },
    "optional_host_permissions": {
      "type": "array",
      "description": "Optional host permissions (MV3)",
      "items": {
        "type": "string"
      }
    },
    "web_accessible_resources": {
      "oneOf": [
        {
          "type": "array",
          "description": "Web accessible resources (MV2)",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "description": "Web accessible resources (MV3)",
          "items": {
            "type": "object",
            "required": ["resources"],
            "properties": {
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extension_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "use_dynamic_url": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "content_security_policy": {
      "oneOf": [
        {
          "type": "string",
          "description": "CSP string (MV2)"
        },
        {
          "type": "object",
          "description": "CSP object (MV3)",
          "properties": {
            "extension_pages": {
              "type": "string"
            },
            "sandbox": {
              "type": "string"
            }
          }
        }
      ]
    },
    "options_page": {
      "type": "string",
      "description": "Options page HTML file"
    },
    "options_ui": {
      "type": "object",
      "description": "Options UI configuration",
      "required": ["page"],
      "properties": {
        "page": {
          "type": "string"
        },
        "open_in_tab": {
          "type": "boolean"
        }
      }
    },
    "devtools_page": {
      "type": "string",
      "description": "DevTools page HTML file"
    },
    "chrome_url_overrides": {
      "type": "object",
      "description": "Chrome URL overrides",
      "properties": {
        "newtab": {
          "type": "string"
        },
        "history": {
          "type": "string"
        },
        "bookmarks": {
          "type": "string"
        }
      }
    },
    "omnibox": {
      "type": "object",
      "description": "Omnibox configuration",
      "required": ["keyword"],
      "properties": {
        "keyword": {
          "type": "string"
        }
      }
    },
    "chrome_settings_overrides": {
      "type": "object",
      "description": "Chrome settings overrides",
      "properties": {
        "homepage": {
          "type": "string"
        },
        "search_provider": {
          "type": "object"
        },
        "startup_pages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "minimum_chrome_version": {
      "type": "string",
      "description": "Minimum Chrome version required"
    },
    "minimum_edge_version": {
      "type": "string",
      "description": "Minimum Edge version required"
    },
    "author": {
      "type": "string",
      "description": "Extension author"
    },
    "homepage_url": {
      "type": "string",
      "description": "Extension homepage URL",
      "format": "uri"
    },
    "update_url": {
      "type": "string",
      "description": "Extension update URL",
      "format": "uri"
    },
    "default_locale": {
      "type": "string",
      "description": "Default locale for i18n"
    },
    "short_name": {
      "type": "string",
      "description": "Short name for the extension",
      "maxLength": 12
    },
    "commands": {
      "type": "object",
      "description": "Keyboard shortcuts",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "suggested_key": {
            "type": "object",
            "properties": {
              "default": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              },
              "linux": {
                "type": "string"
              },
              "windows": {
                "type": "string"
              },
              "chromeos": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "externally_connectable": {
      "type": "object",
      "description": "External connectivity configuration",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepts_tls_channel_id": {
          "type": "boolean"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "description": "Sandboxed pages configuration",
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content_security_policy": {
          "type": "string"
        }
      }
    },
    "browser_specific_settings": {
      "type": "object",
      "description": "Browser-specific settings",
      "properties": {
        "gecko": {
          "type": "object",
          "description": "Firefox-specific settings",
          "properties": {
            "id": {
              "type": "string",
              "description": "Extension ID for Firefox"
            },
            "strict_min_version": {
              "type": "string",
              "description": "Minimum Firefox version"
            },
            "strict_max_version": {
              "type": "string",
              "description": "Maximum Firefox version"
            },
            "update_url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "edge": {
          "type": "object",
          "description": "Edge-specific settings",
          "properties": {
            "browser_action_next_to_addressbar": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "applications": {
      "type": "object",
      "description": "Legacy Firefox settings (use browser_specific_settings instead)",
      "properties": {
        "gecko": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "strict_min_version": {
              "type": "string"
            }
          }
        }
      }
    },
    "side_panel": {
      "type": "object",
      "description": "Side panel configuration (Chrome 114+)",
      "properties": {
        "default_path": {
          "type": "string"
        }
      }
    },
    "declarative_net_request": {
      "type": "object",
      "description": "Declarative Net Request configuration",
      "properties": {
        "rule_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "enabled", "path"],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "incognito": {
      "type": "string",
      "description": "Incognito behavior",
      "enum": ["spanning", "split", "not_allowed"]
    },
    "offline_enabled": {
      "type": "boolean",
      "description": "Whether extension works offline"
    }
  }
}