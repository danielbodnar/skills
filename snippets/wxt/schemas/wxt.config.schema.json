{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WXT Configuration Schema",
  "description": "Schema for wxt.config.ts configuration file",
  "type": "object",
  "properties": {
    "srcDir": {
      "type": "string",
      "description": "Source directory relative to project root",
      "default": "."
    },
    "outDir": {
      "type": "string", 
      "description": "Output directory for builds",
      "default": ".output"
    },
    "publicDir": {
      "type": "string",
      "description": "Public assets directory",
      "default": "public"
    },
    "entrypointsDir": {
      "type": "string",
      "description": "Entrypoints directory relative to srcDir",
      "default": "entrypoints"
    },
    "modulesDir": {
      "type": "string",
      "description": "WXT modules directory",
      "default": "modules"
    },
    "browser": {
      "type": "string",
      "description": "Target browser for development",
      "enum": ["chrome", "firefox", "safari", "edge"],
      "default": "chrome"
    },
    "manifestVersion": {
      "type": "integer",
      "description": "Manifest version to target",
      "enum": [2, 3],
      "default": 3
    },
    "modules": {
      "type": "array",
      "description": "Array of WXT modules to enable",
      "items": {
        "type": "string"
      }
    },
    "alias": {
      "type": "object",
      "description": "Path aliases for imports",
      "additionalProperties": {
        "type": "string"
      }
    },
    "manifest": {
      "type": "object",
      "description": "Override manifest properties",
      "properties": {
        "name": {
          "type": "string",
          "description": "Extension name"
        },
        "description": {
          "type": "string",
          "description": "Extension description"
        },
        "version": {
          "type": "string",
          "description": "Extension version",
          "pattern": "^\\d+(\\.\\d+)*$"
        },
        "permissions": {
          "type": "array",
          "description": "Extension permissions",
          "items": {
            "type": "string"
          }
        },
        "host_permissions": {
          "type": "array",
          "description": "Host permissions (MV3)",
          "items": {
            "type": "string"
          }
        },
        "icons": {
          "type": "object",
          "description": "Extension icons",
          "additionalProperties": {
            "type": "string"
          }
        },
        "action": {
          "type": "object",
          "description": "Browser action configuration",
          "properties": {
            "default_popup": {
              "type": "string"
            },
            "default_title": {
              "type": "string"
            },
            "default_icon": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "content_scripts": {
          "type": "array",
          "description": "Content scripts configuration",
          "items": {
            "type": "object",
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "js": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "css": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "run_at": {
                "type": "string",
                "enum": ["document_start", "document_end", "document_idle"]
              }
            }
          }
        },
        "web_accessible_resources": {
          "type": "array",
          "description": "Web accessible resources",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "matches": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "vite": {
      "type": "function",
      "description": "Vite configuration function"
    },
    "imports": {
      "type": "object",
      "description": "Auto-imports configuration",
      "properties": {
        "disabled": {
          "type": "boolean",
          "description": "Disable auto-imports",
          "default": false
        },
        "presets": {
          "type": "array",
          "description": "Import presets to enable",
          "items": {
            "type": "string",
            "enum": ["react", "vue", "vue-router", "svelte", "solid"]
          }
        },
        "imports": {
          "type": "array",
          "description": "Custom import definitions",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "as": {
                "type": "string"
              }
            }
          }
        },
        "dirs": {
          "type": "array",
          "description": "Directories to scan for auto-imports",
          "items": {
            "type": "string"
          }
        },
        "eslintrc": {
          "type": "object",
          "description": "ESLint integration configuration",
          "properties": {
            "enabled": {
              "type": "integer",
              "description": "ESLint version (8 or 9)",
              "enum": [8, 9]
            },
            "filepath": {
              "type": "string",
              "description": "ESLint config file path"
            },
            "globalsPropValue": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "zip": {
      "type": "object",
      "description": "ZIP generation configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "ZIP file naming pattern"
        },
        "includeSources": {
          "type": "boolean",
          "description": "Include source files in ZIP"
        },
        "excludeSources": {
          "type": "array",
          "description": "Files to exclude from source ZIP",
          "items": {
            "type": "string"
          }
        },
        "artifactTemplate": {
          "type": "string",
          "description": "Artifact naming template"
        },
        "compressionLevel": {
          "type": "integer",
          "description": "ZIP compression level",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "runner": {
      "type": "object",
      "description": "Development runner configuration",
      "properties": {
        "disabled": {
          "type": "boolean",
          "description": "Disable automatic browser startup"
        },
        "startUrls": {
          "type": "array",
          "description": "URLs to open on startup",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "chromiumArgs": {
          "type": "array",
          "description": "Additional Chromium arguments",
          "items": {
            "type": "string"
          }
        },
        "firefoxArgs": {
          "type": "array",
          "description": "Additional Firefox arguments",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "define": {
      "type": "object",
      "description": "Global constants definition",
      "additionalProperties": {
        "type": "string"
      }
    },
    "transformManifest": {
      "type": "function",
      "description": "Function to transform manifest for different browsers"
    },
    "submit": {
      "type": "object",
      "description": "Store submission configuration",
      "properties": {
        "chrome": {
          "type": "object",
          "properties": {
            "extensionId": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "refreshToken": {
              "type": "string"
            }
          }
        },
        "firefox": {
          "type": "object",
          "properties": {
            "extensionId": {
              "type": "string"
            },
            "jwtIssuer": {
              "type": "string"
            },
            "jwtSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "react": {
      "type": "object",
      "description": "React module configuration",
      "properties": {
        "vite": {
          "type": "object",
          "description": "React-specific Vite options"
        }
      }
    },
    "vue": {
      "type": "object",
      "description": "Vue module configuration",
      "properties": {
        "vite": {
          "type": "object",
          "description": "Vue-specific Vite options"
        }
      }
    },
    "svelte": {
      "type": "object",
      "description": "Svelte module configuration",
      "properties": {
        "vite": {
          "type": "object",
          "description": "Svelte-specific Vite options"
        }
      }
    },
    "solid": {
      "type": "object",
      "description": "Solid module configuration",
      "properties": {
        "vite": {
          "type": "object",
          "description": "Solid-specific Vite options"
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "Internationalization configuration",
      "properties": {
        "defaultLocale": {
          "type": "string",
          "description": "Default locale"
        },
        "locales": {
          "type": "array",
          "description": "Supported locales",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "autoIcons": {
      "type": "object",
      "description": "Auto icons module configuration",
      "properties": {
        "baseIconPath": {
          "type": "string",
          "description": "Base icon file path"
        },
        "sizes": {
          "type": "array",
          "description": "Icon sizes to generate",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "unocss": {
      "type": "object",
      "description": "UnoCSS module configuration",
      "properties": {
        "excludeEntrypoints": {
          "type": "array",
          "description": "Entrypoints to exclude from UnoCSS",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}