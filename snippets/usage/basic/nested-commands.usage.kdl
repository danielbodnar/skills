// CLI with nested subcommands and aliases
min_usage_version "1.0.0"

name "Project Manager"
bin "pm"
about "A project management CLI tool"
version "2.0.0"
author "Daniel Bodnar"
license "MIT"

// Global flags available to all commands
flag "-v --verbose" help="Enable verbose logging" global=true count=true
flag "-q --quiet" help="Suppress output" global=true
flag "--config <file>" help="Configuration file" global=true env="PM_CONFIG"

// Project management commands
cmd "project" help="Manage projects" {
  cmd "create" help="Create a new project" {
    alias "new" "add"
    arg "<name>" help="Project name"
    flag "--template <template>" help="Project template" default="basic"
    flag "--lang <language>" help="Programming language" default="typescript"
    example "Create TypeScript project" "pm project create myapp --lang typescript"
    example "Create from template" "pm project create myapp --template vue"
  }
  
  cmd "list" help="List all projects" {
    alias "ls"
    flag "--format <format>" help="Output format" default="table"
    flag "--filter <filter>" help="Filter projects"
    example "List all projects" "pm project list"
    example "List in JSON format" "pm project list --format json"
  }
  
  cmd "remove" help="Remove a project" {
    alias "rm" "delete"
    arg "<name>" help="Project name to remove"
    flag "-f --force" help="Force removal without confirmation"
    example "Remove project" "pm project remove myapp"
    example "Force remove" "pm project remove myapp --force"
  }
}

// Configuration management
cmd "config" help="Manage configuration" {
  cmd "get" help="Get configuration value" {
    arg "<key>" help="Configuration key"
    example "Get user setting" "pm config get user.name"
  }
  
  cmd "set" help="Set configuration value" {
    arg "<key>" help="Configuration key"
    arg "<value>" help="Configuration value"
    flag "-g --global" help="Set global configuration"
    example "Set user name" "pm config set user.name 'John Doe'"
    example "Set global setting" "pm config set --global editor.default vim"
  }
  
  cmd "list" help="List all configuration" {
    alias "ls"
    flag "--global" help="Show global configuration only"
    flag "--local" help="Show local configuration only"
  }
}

// Build and deployment
cmd "build" help="Build the project" {
  flag "--watch" help="Watch for file changes"
  flag "--target <target>" help="Build target" default="production"
  flag "--output <dir>" help="Output directory" default="dist"
  arg "[entry]" help="Entry point" default="src/main.ts"
  
  example "Production build" "pm build"
  example "Development build with watch" "pm build --target development --watch"
}