// Simple CLI specification with basic flags and arguments
min_usage_version "1.0.0"

name "My CLI"
bin "mycli"
about "A simple command-line tool"
version "1.0.0"
author "Daniel Bodnar"
license "MIT"

// Global flags
flag "-h --help" help="Show help information"
flag "-V --version" help="Show version information"
flag "-v --verbose" help="Enable verbose output" count=true

// Basic flags
flag "-f --force" help="Force operation without confirmation"
flag "-q --quiet" help="Suppress output"

// Flags with values
flag "-u --user <user>" help="User to run as" env="CLI_USER" default="admin"
flag "--config <file>" help="Configuration file path" default="config.toml"

// Required positional argument
arg "<input>" help="Input file to process"

// Optional positional argument
arg "[output]" help="Output file (default: stdout)"