// Advanced configuration integration example
min_usage_version "1.0.0"

name "Advanced CLI"
bin "acli"
about "CLI with advanced configuration integration"
version "1.0.0"
author "Daniel Bodnar"
license "MIT"

// Configuration file with findup behavior
config_file ".acli.toml" findup=true

// Multiple configuration sources with priority
flag "-u --user <user>" help="User to run as" {
  env="ACLI_USER"           // Environment variable
  config="auth.user"        // Config file path
  default="admin"           // Default value
}

flag "--api-key <key>" help="API key for authentication" {
  env="ACLI_API_KEY"
  config="auth.api_key"
  // No default for security
}

flag "--timeout <seconds>" help="Request timeout in seconds" {
  env="ACLI_TIMEOUT"
  config="network.timeout"
  default="30"
}

flag "--base-url <url>" help="Base URL for API requests" {
  env="ACLI_BASE_URL"
  config="network.base_url"
  default="https://api.example.com"
}

// Database configuration
flag "--db-host <host>" help="Database host" {
  env="DB_HOST"
  config="database.host"
  default="localhost"
}

flag "--db-port <port>" help="Database port" {
  env="DB_PORT"
  config="database.port"
  default="5432"
}

flag "--db-name <name>" help="Database name" {
  env="DB_NAME"
  config="database.name"
  default="myapp"
}

// Feature flags
flag "--enable-cache" help="Enable caching" {
  env="ACLI_ENABLE_CACHE"
  config="features.cache_enabled"
  default="true"
}

flag "--debug" help="Enable debug mode" {
  env="ACLI_DEBUG"
  config="logging.debug"
  default="false"
}

// Command with configuration
cmd "deploy" help="Deploy application" {
  flag "--env <environment>" help="Deployment environment" {
    env="DEPLOY_ENV"
    config="deploy.environment"
    default="staging"
  }
  
  flag "--replicas <count>" help="Number of replicas" {
    env="DEPLOY_REPLICAS"
    config="deploy.replicas"
    default="3"
  }
  
  arg "<app>" help="Application to deploy"
}

// Example configuration file content:
// [auth]
// user = "developer"
// api_key = "your-api-key-here"
//
// [network]
// timeout = 60
// base_url = "https://api.staging.example.com"
//
// [database]
// host = "db.example.com"
// port = 5432
// name = "production_db"
//
// [features]
// cache_enabled = true
//
// [logging]
// debug = false
//
// [deploy]
// environment = "production"
// replicas = 5