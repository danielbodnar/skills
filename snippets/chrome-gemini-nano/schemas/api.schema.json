{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://developer.chrome.com/schemas/ai/gemini-nano/api.json",
  "title": "Chrome Gemini Nano API Schema",
  "description": "Schema definitions for Chrome Gemini Nano API interfaces and responses",
  "definitions": {
    "AICapabilities": {
      "type": "object",
      "properties": {
        "available": {
          "type": "string",
          "enum": ["readily", "after-download", "no"],
          "description": "Availability status of the AI model"
        },
        "defaultTemperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "defaultTopK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "maxTopK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        }
      },
      "required": ["available"],
      "additionalProperties": false
    },
    "AISessionConfig": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "systemPrompt": {
          "type": "string",
          "maxLength": 2000
        },
        "signal": {
          "description": "AbortSignal object for cancellation"
        }
      },
      "additionalProperties": false
    },
    "AISession": {
      "type": "object",
      "description": "Chrome AI Session interface",
      "properties": {
        "prompt": {
          "type": "function",
          "description": "Send a prompt and get a complete response"
        },
        "promptStreaming": {
          "type": "function", 
          "description": "Send a prompt and get a streaming response"
        },
        "clone": {
          "type": "function",
          "description": "Create a new session with the same configuration"
        },
        "destroy": {
          "type": "function",
          "description": "Destroy the session and free resources"
        }
      },
      "required": ["prompt", "promptStreaming", "destroy"]
    },
    "PromptRequest": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "The text prompt to send to the AI"
        }
      },
      "required": ["prompt"],
      "additionalProperties": false
    },
    "PromptResponse": {
      "type": "string",
      "description": "AI-generated response text"
    },
    "StreamingChunk": {
      "type": "string",
      "description": "Individual chunk of streaming response"
    },
    "AIError": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "NotSupportedError",
            "NotAllowedError", 
            "InvalidStateError",
            "AbortError",
            "QuotaExceededError",
            "NetworkError"
          ]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "code": {
          "type": "integer",
          "description": "Numeric error code if available"
        }
      },
      "required": ["name", "message"],
      "additionalProperties": false
    },
    "BrowserSupport": {
      "type": "object",
      "properties": {
        "hasAI": {
          "type": "boolean",
          "description": "Whether window.ai is available"
        },
        "hasLanguageModel": {
          "type": "boolean", 
          "description": "Whether window.ai.languageModel is available"
        },
        "chromeVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+",
          "description": "Chrome browser version"
        },
        "platform": {
          "type": "string",
          "enum": ["Windows", "macOS", "Linux", "ChromeOS", "Android", "iOS"],
          "description": "Operating system platform"
        },
        "deviceMemory": {
          "type": "number",
          "minimum": 0,
          "description": "Device memory in GB"
        },
        "hardwareConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of CPU cores"
        }
      },
      "required": ["hasAI", "hasLanguageModel"],
      "additionalProperties": false
    }
  },
  "properties": {
    "window.ai.languageModel.capabilities": {
      "type": "function",
      "returns": {
        "$ref": "#/definitions/AICapabilities"
      },
      "description": "Check AI model availability and capabilities"
    },
    "window.ai.languageModel.create": {
      "type": "function",
      "parameters": {
        "$ref": "#/definitions/AISessionConfig"
      },
      "returns": {
        "$ref": "#/definitions/AISession"
      },
      "description": "Create a new AI session with configuration"
    },
    "session.prompt": {
      "type": "function",
      "parameters": {
        "type": "string"
      },
      "returns": {
        "$ref": "#/definitions/PromptResponse"
      },
      "throws": {
        "$ref": "#/definitions/AIError"
      },
      "description": "Send a prompt and receive complete response"
    },
    "session.promptStreaming": {
      "type": "function",
      "parameters": {
        "type": "string"
      },
      "returns": {
        "type": "AsyncIterator",
        "items": {
          "$ref": "#/definitions/StreamingChunk"
        }
      },
      "throws": {
        "$ref": "#/definitions/AIError"
      },
      "description": "Send a prompt and receive streaming response"
    }
  },
  "examples": [
    {
      "description": "Basic availability check",
      "code": "const capabilities = await window.ai.languageModel.capabilities();"
    },
    {
      "description": "Create session and prompt",
      "code": "const session = await window.ai.languageModel.create({temperature: 0.7}); const response = await session.prompt('Hello');"
    },
    {
      "description": "Streaming response",
      "code": "for await (const chunk of session.promptStreaming('Tell me a story')) { console.log(chunk); }"
    }
  ]
}