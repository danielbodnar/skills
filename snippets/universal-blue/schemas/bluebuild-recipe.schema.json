{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blue-build.org/schemas/recipe.json",
  "title": "BlueBuild Recipe Schema",
  "description": "Schema for BlueBuild recipe configuration files",
  "type": "object",
  "required": ["name", "description", "base-image", "image-version"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the custom image",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "description": "Description of the custom image",
      "minLength": 1,
      "maxLength": 200
    },
    "base-image": {
      "type": "string",
      "description": "Base container image to build from",
      "pattern": "^(ghcr\\.io/ublue-os/|docker\\.io/|quay\\.io/)",
      "examples": [
        "ghcr.io/ublue-os/silverblue-main:latest",
        "ghcr.io/ublue-os/kinoite-main:latest",
        "ghcr.io/ublue-os/bazzite:latest"
      ]
    },
    "image-version": {
      "type": "string",
      "description": "Version tag for the image",
      "default": "latest",
      "examples": ["latest", "40", "39", "stable"]
    },
    "blue-build-template": {
      "type": "string",
      "description": "BlueBuild template version",
      "default": "latest"
    },
    "stages": {
      "type": "array",
      "description": "Build stages to execute",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/rpm-ostree-stage"
          },
          {
            "$ref": "#/definitions/script-stage"
          },
          {
            "$ref": "#/definitions/files-stage"
          },
          {
            "$ref": "#/definitions/systemd-stage"
          },
          {
            "$ref": "#/definitions/fonts-stage"
          },
          {
            "$ref": "#/definitions/signing-stage"
          }
        ]
      }
    },
    "modules": {
      "type": "array",
      "description": "BlueBuild modules to include",
      "items": {
        "$ref": "#/definitions/module"
      }
    }
  },
  "definitions": {
    "rpm-ostree-stage": {
      "type": "object",
      "description": "RPM-OSTree package management stage",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "rpm-ostree"
        },
        "repos": {
          "type": "array",
          "description": "Additional RPM repositories to enable",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "keys": {
          "type": "array",
          "description": "GPG keys for repository verification",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "install": {
          "type": "array",
          "description": "Packages to install",
          "items": {
            "type": "string"
          }
        },
        "remove": {
          "type": "array",
          "description": "Packages to remove",
          "items": {
            "type": "string"
          }
        },
        "replace": {
          "type": "array",
          "description": "Packages to replace",
          "items": {
            "type": "object",
            "required": ["from-repo", "packages"],
            "properties": {
              "from-repo": {
                "type": "string"
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "script-stage": {
      "type": "object",
      "description": "Custom script execution stage",
      "required": ["type", "scripts"],
      "properties": {
        "type": {
          "const": "script"
        },
        "scripts": {
          "type": "array",
          "description": "Scripts to execute",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "files-stage": {
      "type": "object",
      "description": "File copying stage",
      "required": ["type", "files"],
      "properties": {
        "type": {
          "const": "files"
        },
        "files": {
          "type": "array",
          "description": "Files to copy",
          "items": {
            "type": "object",
            "required": ["src", "dst"],
            "properties": {
              "src": {
                "type": "string",
                "description": "Source file or directory path"
              },
              "dst": {
                "type": "string",
                "description": "Destination path in the image"
              }
            }
          }
        }
      }
    },
    "systemd-stage": {
      "type": "object",
      "description": "Systemd service management stage",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "systemd"
        },
        "system": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "array",
              "description": "System services to enable",
              "items": {
                "type": "string"
              }
            },
            "disabled": {
              "type": "array",
              "description": "System services to disable",
              "items": {
                "type": "string"
              }
            },
            "masked": {
              "type": "array",
              "description": "System services to mask",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "user": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "array",
              "description": "User services to enable",
              "items": {
                "type": "string"
              }
            },
            "disabled": {
              "type": "array",
              "description": "User services to disable",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "fonts-stage": {
      "type": "object",
      "description": "Font installation stage",
      "required": ["type", "fonts"],
      "properties": {
        "type": {
          "const": "fonts"
        },
        "fonts": {
          "type": "object",
          "properties": {
            "nerd-fonts": {
              "type": "array",
              "description": "Nerd Fonts to install",
              "items": {
                "type": "string",
                "enum": [
                  "FiraCode",
                  "JetBrainsMono",
                  "Hack",
                  "SourceCodePro",
                  "CascadiaCode",
                  "Inconsolata",
                  "UbuntuMono",
                  "DejaVuSansMono"
                ]
              }
            },
            "google-fonts": {
              "type": "array",
              "description": "Google Fonts to install",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "signing-stage": {
      "type": "object",
      "description": "Image signing configuration",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "signing"
        },
        "cosign": {
          "type": "boolean",
          "description": "Enable Cosign signing",
          "default": false
        },
        "key": {
          "type": "string",
          "description": "Signing key path or reference"
        }
      }
    },
    "module": {
      "type": "object",
      "description": "BlueBuild module configuration",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Module type",
          "examples": [
            "akmods",
            "bling",
            "brew",
            "distrobox",
            "flatpaks",
            "fonts",
            "gnome",
            "kde",
            "nvidia",
            "steam",
            "virtualization",
            "waydroid"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}