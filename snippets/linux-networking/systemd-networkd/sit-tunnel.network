# systemd-networkd SIT Tunnel Configuration
# File: /etc/systemd/network/25-sit0.netdev
[NetDev]
Name=sit0
Kind=sit

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.20
Mode=sit

# File: /etc/systemd/network/25-sit0.network
[Match]
Name=sit0

[Network]
Address=2001:db8:1::1/64

[Route]
Destination=2001:db8:2::/64
Gateway=2001:db8:1::2

# SIT with Any Mode
# File: /etc/systemd/network/25-sit-any.netdev
[NetDev]
Name=sit-any
Kind=sit

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.20
Mode=any

# File: /etc/systemd/network/25-sit-any.network
[Match]
Name=sit-any

[Network]
Address=2001:db8:3::1/64

# 6to4 Tunnel
# File: /etc/systemd/network/25-6to4.netdev
[NetDev]
Name=6to4
Kind=sit

[Tunnel]
Mode=6to4
Local=192.168.1.10

# File: /etc/systemd/network/25-6to4.network
[Match]
Name=6to4

[Network]
Address=2002:c0a8:10a::1/16