# systemd-networkd IPVLAN Configuration
# File: /etc/systemd/network/25-ipvlan0.netdev
[NetDev]
Name=ipvlan0
Kind=ipvlan

[IPVLAN]
Mode=L2

# File: /etc/systemd/network/25-ipvlan0.network
[Match]
Name=ipvlan0

[Network]
Address=192.168.1.110/24
Gateway=192.168.1.1

# L3 Mode IPVLAN
# File: /etc/systemd/network/25-ipvlan-l3.netdev
[NetDev]
Name=ipvlan-l3
Kind=ipvlan

[IPVLAN]
Mode=L3

# File: /etc/systemd/network/25-ipvlan-l3.network
[Match]
Name=ipvlan-l3

[Network]
Address=10.0.0.1/24

# Bind to physical interface
# File: /etc/systemd/network/10-eth0.network
[Match]
Name=eth0

[Network]
IPVLAN=ipvlan0
IPVLAN=ipvlan-l3