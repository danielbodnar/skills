# systemd-networkd GRE Tunnel Configuration
# File: /etc/systemd/network/25-gre0.netdev
[NetDev]
Name=gre0
Kind=gre

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.20
Mode=gre

# File: /etc/systemd/network/25-gre0.network
[Match]
Name=gre0

[Network]
Address=10.0.0.1/30

[Route]
Destination=10.1.0.0/24
Gateway=10.0.0.2

# GRE with Key
# File: /etc/systemd/network/25-gre-key.netdev
[NetDev]
Name=gre-key
Kind=gre

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.20
Key=1234

# File: /etc/systemd/network/25-gre-key.network
[Match]
Name=gre-key

[Network]
Address=10.0.1.1/30

# Multiple GRE tunnels
# File: /etc/systemd/network/25-gre1.netdev
[NetDev]
Name=gre1
Kind=gre

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.30

# File: /etc/systemd/network/25-gre1.network
[Match]
Name=gre1

[Network]
Address=10.0.2.1/30