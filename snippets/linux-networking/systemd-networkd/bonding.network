# systemd-networkd Bonding Configuration
# File: /etc/systemd/network/25-bond0.netdev
[NetDev]
Name=bond0
Kind=bond

[Bond]
Mode=802.3ad
TransmitHashPolicy=layer3+4
LACPTransmitRate=fast
MIIMonitorSec=1s

# File: /etc/systemd/network/25-bond0.network
[Match]
Name=bond0

[Network]
Address=192.168.1.50/24
Gateway=192.168.1.1
DNS=8.8.8.8

# Bind slave interfaces
# File: /etc/systemd/network/10-eth0.network
[Match]
Name=eth0

[Network]
Bond=bond0

# File: /etc/systemd/network/10-eth1.network
[Match]
Name=eth1

[Network]
Bond=bond0

# Active-Backup Bonding
# File: /etc/systemd/network/25-bond-backup.netdev
[NetDev]
Name=bond-backup
Kind=bond

[Bond]
Mode=active-backup
MIIMonitorSec=1s
PrimaryReselectPolicy=always

# File: /etc/systemd/network/25-bond-backup.network
[Match]
Name=bond-backup

[Network]
Address=192.168.2.50/24
Gateway=192.168.2.1