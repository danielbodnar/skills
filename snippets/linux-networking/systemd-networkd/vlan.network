# systemd-networkd VLAN Configuration
# File: /etc/systemd/network/25-vlan10.netdev
[NetDev]
Name=vlan10
Kind=vlan

[VLAN]
Id=10

# File: /etc/systemd/network/25-vlan10.network
[Match]
Name=vlan10

[Network]
Address=192.168.10.1/24

# Multiple VLANs on same interface
# File: /etc/systemd/network/25-vlan20.netdev
[NetDev]
Name=vlan20
Kind=vlan

[VLAN]
Id=20

# File: /etc/systemd/network/25-vlan20.network
[Match]
Name=vlan20

[Network]
Address=192.168.20.1/24

# Bind VLANs to physical interface
# File: /etc/systemd/network/10-eth0.network
[Match]
Name=eth0

[Network]
VLAN=vlan10
VLAN=vlan20

# QinQ (802.1ad) VLAN
# File: /etc/systemd/network/25-qinq.netdev
[NetDev]
Name=qinq
Kind=vlan

[VLAN]
Id=100
Protocol=802.1ad

# File: /etc/systemd/network/25-qinq.network
[Match]
Name=qinq

[Network]
Address=192.168.100.1/24