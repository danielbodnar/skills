# systemd-networkd IPIP Tunnel Configuration
# File: /etc/systemd/network/25-ipip0.netdev
[NetDev]
Name=ipip0
Kind=ipip

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.20
Mode=ipip

# File: /etc/systemd/network/25-ipip0.network
[Match]
Name=ipip0

[Network]
Address=10.0.0.1/30

[Route]
Destination=10.2.0.0/24
Gateway=10.0.0.2

# IPIP with specific TTL
# File: /etc/systemd/network/25-ipip-ttl.netdev
[NetDev]
Name=ipip-ttl
Kind=ipip

[Tunnel]
Local=192.168.1.10
Remote=192.168.1.20
TTL=64

# File: /etc/systemd/network/25-ipip-ttl.network
[Match]
Name=ipip-ttl

[Network]
Address=10.0.3.1/30