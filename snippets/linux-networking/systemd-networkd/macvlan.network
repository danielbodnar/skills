# systemd-networkd MACVLAN Configuration
# File: /etc/systemd/network/25-macvlan0.netdev
[NetDev]
Name=macvlan0
Kind=macvlan

[MACVLAN]
Mode=bridge

# File: /etc/systemd/network/25-macvlan0.network
[Match]
Name=macvlan0

[Network]
Address=192.168.1.100/24
Gateway=192.168.1.1
DNS=8.8.8.8

# File: /etc/systemd/network/10-eth0.network (bind MACVLAN to physical interface)
[Match]
Name=eth0

[Network]
MACVLAN=macvlan0

# Multiple MACVLAN interfaces
# File: /etc/systemd/network/25-macvlan1.netdev
[NetDev]
Name=macvlan1
Kind=macvlan

[MACVLAN]
Mode=bridge

# File: /etc/systemd/network/25-macvlan1.network
[Match]
Name=macvlan1

[Network]
Address=192.168.1.101/24
Gateway=192.168.1.1