# systemd-networkd Bridge Configuration
# File: /etc/systemd/network/25-br0.netdev
[NetDev]
Name=br0
Kind=bridge

[Bridge]
STP=yes
ForwardDelaySec=4
HelloTimeSec=2
MaxAgeSec=20

# File: /etc/systemd/network/25-br0.network
[Match]
Name=br0

[Network]
Address=192.168.10.1/24
DHCPServer=yes

[DHCPServer]
PoolOffset=100
PoolSize=50
EmitDNS=yes
DNS=8.8.8.8

# Bind physical interface to bridge
# File: /etc/systemd/network/10-eth0.network
[Match]
Name=eth0

[Network]
Bridge=br0

# Bind VETH to bridge
# File: /etc/systemd/network/25-veth0-bridge.network
[Match]
Name=veth0

[Network]
Bridge=br0

# Bridge with VLAN filtering
# File: /etc/systemd/network/25-br-vlan.netdev
[NetDev]
Name=br-vlan
Kind=bridge

[Bridge]
VLANFiltering=yes
DefaultPVID=1

# File: /etc/systemd/network/25-br-vlan.network
[Match]
Name=br-vlan

[Network]
Address=192.168.20.1/24