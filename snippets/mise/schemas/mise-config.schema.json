{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mise Configuration Schema",
  "description": "Schema for mise.toml configuration files",
  "type": "object",
  "properties": {
    "min_version": {
      "type": "string",
      "description": "Minimum version of mise required",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tools": {
      "type": "object",
      "description": "Tool versions to install",
      "patternProperties": {
        "^[a-zA-Z0-9_:/-]+$": {
          "oneOf": [
            {
              "type": "string",
              "description": "Version specification"
            },
            {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "description": "Tool version"
                },
                "virtualenv": {
                  "type": "string",
                  "description": "Python virtual environment path"
                },
                "extras": {
                  "type": "string",
                  "description": "Extra dependencies to install"
                },
                "tags": {
                  "type": "string",
                  "description": "Build tags for Go packages"
                }
              }
            }
          ]
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Environment variables",
      "properties": {
        "_": {
          "type": "object",
          "description": "Special environment directives",
          "properties": {
            "path": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "string"
                }
              ],
              "description": "Paths to add to PATH"
            },
            "file": {
              "type": "string",
              "description": "File to load environment variables from"
            },
            "python": {
              "type": "object",
              "properties": {
                "venv": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "create": {
                          "type": "boolean"
                        },
                        "python": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "patternProperties": {
        "^[A-Z_][A-Z0-9_]*$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "tools": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "Template variables",
      "properties": {
        "_": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "File to load variables from"
            }
          }
        }
      },
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "object",
      "description": "Task definitions",
      "patternProperties": {
        "^[a-zA-Z0-9_:-]+$": {
          "oneOf": [
            {
              "type": "string",
              "description": "Simple command"
            },
            {
              "type": "object",
              "properties": {
                "run": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ],
                  "description": "Command(s) to run"
                },
                "run_windows": {
                  "type": "string",
                  "description": "Windows-specific command"
                },
                "description": {
                  "type": "string",
                  "description": "Task description"
                },
                "alias": {
                  "type": "string",
                  "description": "Short alias for the task"
                },
                "depends": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Task dependencies"
                },
                "env": {
                  "type": "object",
                  "description": "Task-specific environment variables"
                },
                "dir": {
                  "type": "string",
                  "description": "Working directory"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Source files to watch"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Output files"
                },
                "hide": {
                  "type": "boolean",
                  "description": "Hide task from list"
                },
                "confirm": {
                  "type": "string",
                  "description": "Confirmation prompt"
                },
                "usage": {
                  "type": "string",
                  "description": "Usage specification"
                },
                "file": {
                  "type": "string",
                  "description": "External script file"
                },
                "tools": {
                  "type": "object",
                  "description": "Task-specific tools"
                }
              }
            }
          ]
        }
      }
    },
    "task_config": {
      "type": "object",
      "description": "Global task configuration",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Default working directory"
        },
        "env": {
          "type": "object",
          "description": "Default environment variables"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task files to include"
        }
      }
    },
    "hooks": {
      "type": "object",
      "description": "Lifecycle hooks",
      "properties": {
        "enter": {
          "type": "string",
          "description": "Command to run when entering directory"
        },
        "leave": {
          "type": "string",
          "description": "Command to run when leaving directory"
        },
        "postinstall": {
          "type": "string",
          "description": "Command to run after tool installation"
        }
      }
    },
    "watch_files": {
      "type": "array",
      "description": "File watching configuration",
      "items": {
        "type": "object",
        "properties": {
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "File patterns to watch"
          },
          "run": {
            "type": "string",
            "description": "Command to run on changes"
          }
        },
        "required": ["patterns", "run"]
      }
    },
    "settings": {
      "type": "object",
      "description": "Mise settings",
      "properties": {
        "always_keep_download": {
          "type": "boolean"
        },
        "always_keep_install": {
          "type": "boolean"
        },
        "plugin_autoupdate_last_check_duration": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "asdf_compat": {
          "type": "boolean"
        },
        "jobs": {
          "type": "integer"
        },
        "raw": {
          "type": "boolean"
        },
        "yes": {
          "type": "boolean"
        },
        "not_found_auto_install": {
          "type": "boolean"
        },
        "task_output": {
          "type": "string",
          "enum": ["prefix", "interleave"]
        },
        "paranoid": {
          "type": "boolean"
        },
        "shorthands_file": {
          "type": "string"
        },
        "disable_default_shorthands": {
          "type": "boolean"
        },
        "disable_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disable_backends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}