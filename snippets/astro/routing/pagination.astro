---
// src/pages/blog/[...page].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  
  // Sort posts by date (newest first)
  const sortedPosts = posts.sort((a, b) => 
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  
  return paginate(sortedPosts, {
    pageSize: 6,
  });
}

const { page } = Astro.props;
---

<Layout title="Blog" description="Browse our latest blog posts">
  <div class="blog-page">
    <header class="page-header">
      <h1>Blog</h1>
      <p>Page {page.currentPage} of {page.lastPage}</p>
    </header>
    
    <div class="posts-grid">
      {page.data.map(post => (
        <article class="post-card">
          {post.data.image && (
            <img 
              src={post.data.image.src} 
              alt={post.data.image.alt}
              class="post-image"
            />
          )}
          <div class="post-content">
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-description">{post.data.description}</p>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString()}
              </time>
              <span class="author">{post.data.author}</span>
            </div>
            <div class="post-tags">
              {post.data.tags.slice(0, 3).map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
    
    <nav class="pagination" aria-label="Blog pagination">
      {page.url.prev && (
        <a href={page.url.prev} class="pagination-link pagination-prev">
          ← Previous
        </a>
      )}
      
      <div class="pagination-numbers">
        {page.url.first && page.currentPage > 2 && (
          <>
            <a href={page.url.first} class="pagination-link">1</a>
            {page.currentPage > 3 && <span class="pagination-ellipsis">...</span>}
          </>
        )}
        
        {page.currentPage > 1 && (
          <a href={page.url.prev} class="pagination-link">
            {page.currentPage - 1}
          </a>
        )}
        
        <span class="pagination-link pagination-current">
          {page.currentPage}
        </span>
        
        {page.currentPage < page.lastPage && (
          <a href={page.url.next} class="pagination-link">
            {page.currentPage + 1}
          </a>
        )}
        
        {page.url.last && page.currentPage < page.lastPage - 1 && (
          <>
            {page.currentPage < page.lastPage - 2 && <span class="pagination-ellipsis">...</span>}
            <a href={page.url.last} class="pagination-link">{page.lastPage}</a>
          </>
        )}
      </div>
      
      {page.url.next && (
        <a href={page.url.next} class="pagination-link pagination-next">
          Next →
        </a>
      )}
    </nav>
    
    <div class="pagination-info">
      Showing {page.start + 1}-{page.end + 1} of {page.total} posts
    </div>
  </div>
</Layout>

<style>
  .blog-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .post-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }
  
  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .post-content {
    padding: 1.5rem;
  }
  
  .post-content h2 {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
  }
  
  .post-content a {
    text-decoration: none;
    color: #333;
    transition: color 0.2s ease;
  }
  
  .post-content a:hover {
    color: #667eea;
  }
  
  .post-description {
    color: #666;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  
  .post-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 1rem;
  }
  
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tag {
    background: #f0f0f0;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }
  
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .pagination-numbers {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }
  
  .pagination-link {
    padding: 0.5rem 1rem;
    text-decoration: none;
    border: 1px solid #ddd;
    border-radius: 6px;
    color: #667eea;
    transition: all 0.2s ease;
  }
  
  .pagination-link:hover {
    background: #667eea;
    color: white;
    border-color: #667eea;
  }
  
  .pagination-current {
    background: #667eea;
    color: white;
    border-color: #667eea;
  }
  
  .pagination-ellipsis {
    padding: 0.5rem;
    color: #888;
  }
  
  .pagination-info {
    text-align: center;
    color: #666;
    font-size: 0.9rem;
  }
  
  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
    
    .pagination {
      flex-wrap: wrap;
    }
    
    .pagination-numbers {
      order: 3;
      flex-basis: 100%;
      justify-content: center;
      margin-top: 0.5rem;
    }
  }
</style>