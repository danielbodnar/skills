---
// Optimized image component with responsive loading
import { Image } from 'astro:assets';

export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  quality?: number;
  format?: 'webp' | 'avif' | 'jpeg' | 'png';
  class?: string;
  caption?: string;
  placeholder?: 'blur' | 'empty';
}

const {
  src,
  alt,
  width,
  height,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
  loading = 'lazy',
  quality = 80,
  format = 'webp',
  class: className = '',
  caption,
  placeholder = 'blur',
} = Astro.props;

// Generate responsive sizes
const breakpoints = [400, 800, 1200, 1600];
const responsiveSizes = breakpoints.map(bp => ({
  width: bp,
  height: Math.round((height / width) * bp),
}));
---

<figure class={`image-container ${className}`}>
  <picture>
    <!-- AVIF format for modern browsers -->
    <source
      type="image/avif"
      srcset={responsiveSizes.map(size => 
        `/_astro/${src}?f=avif&w=${size.width}&q=${quality} ${size.width}w`
      ).join(', ')}
      sizes={sizes}
    />
    
    <!-- WebP format for most browsers -->
    <source
      type="image/webp"
      srcset={responsiveSizes.map(size => 
        `/_astro/${src}?f=webp&w=${size.width}&q=${quality} ${size.width}w`
      ).join(', ')}
      sizes={sizes}
    />
    
    <!-- Fallback to original format -->
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      quality={quality}
      format={format}
      sizes={sizes}
      class="responsive-image"
      data-placeholder={placeholder}
    />
  </picture>
  
  {caption && (
    <figcaption class="image-caption">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .image-container {
    margin: 0;
    position: relative;
    overflow: hidden;
  }
  
  .responsive-image {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.3s ease;
  }
  
  .responsive-image[data-placeholder="blur"] {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
  }
  
  @keyframes loading {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
  
  .image-caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
    text-align: center;
    font-style: italic;
  }
  
  /* Intersection Observer for lazy loading enhancement */
  .responsive-image:not([loading="eager"]) {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .responsive-image.loaded {
    opacity: 1;
  }
  
  /* Responsive utilities */
  @media (max-width: 768px) {
    .image-container {
      margin: 1rem -1rem;
    }
  }
  
  /* Print styles */
  @media print {
    .responsive-image {
      page-break-inside: avoid;
    }
  }
</style>

<script>
  // Enhanced lazy loading with Intersection Observer
  function initImageObserver() {
    const images = document.querySelectorAll('img[loading="lazy"]');
    
    if ('IntersectionObserver' in window) {
      const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const img = entry.target as HTMLImageElement;
            
            // Remove placeholder animation
            img.style.animation = 'none';
            
            // Add loaded class for fade-in effect
            img.addEventListener('load', () => {
              img.classList.add('loaded');
              
              // Dispatch custom event for tracking
              img.dispatchEvent(new CustomEvent('imageLoaded', {
                detail: { src: img.src, alt: img.alt }
              }));
            });
            
            observer.unobserve(img);
          }
        });
      }, {
        rootMargin: '50px 0px',
        threshold: 0.1
      });
      
      images.forEach(img => imageObserver.observe(img));
    }
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageObserver);
  } else {
    initImageObserver();
  }
  
  // Performance monitoring
  function trackImagePerformance() {
    const observer = new PerformanceObserver((list) => {
      list.getEntries().forEach((entry) => {
        if (entry.initiatorType === 'img') {
          console.log(`Image loaded: ${entry.name} - ${entry.duration}ms`);
          
          // Send to analytics if configured
          if (typeof gtag !== 'undefined') {
            gtag('event', 'image_load_time', {
              event_category: 'performance',
              event_label: entry.name,
              value: Math.round(entry.duration)
            });
          }
        }
      });
    });
    
    observer.observe({ entryTypes: ['resource'] });
  }
  
  // Start performance tracking
  trackImagePerformance();
</script>