---
// Query content collections
import { getCollection, getEntry, getEntries } from 'astro:content';

// Get all blog posts
const allBlogPosts = await getCollection('blog');

// Filter published posts only
const publishedPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Get featured posts
const featuredPosts = await getCollection('blog', ({ data }) => {
  return data.featured;
});

// Sort posts by date (newest first)
const sortedPosts = publishedPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Get specific entry
const specificPost = await getEntry('blog', 'my-first-post');

// Get multiple specific entries
const postIds = ['post-1', 'post-2', 'post-3'];
const multiplePosts = await getEntries(
  postIds.map(id => ({ collection: 'blog', id }))
);

// Get all authors
const allAuthors = await getCollection('authors');

// Get entries by subdirectory
const techPosts = await getCollection('blog', ({ id }) => {
  return id.startsWith('tech/');
});
---

<div class="blog-listing">
  <h1>Blog Posts</h1>
  
  <section class="featured">
    <h2>Featured Posts</h2>
    {featuredPosts.map(post => (
      <article>
        <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <time>{post.data.pubDate.toDateString()}</time>
      </article>
    ))}
  </section>
  
  <section class="all-posts">
    <h2>All Posts</h2>
    {sortedPosts.map(post => (
      <article>
        <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <div class="meta">
          <time>{post.data.pubDate.toDateString()}</time>
          <span class="author">{post.data.author}</span>
          <div class="tags">
            {post.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>
</div>

<style>
  .blog-listing {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }
  
  article {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eee;
  }
  
  article h3 {
    margin: 0 0 0.5rem 0;
  }
  
  article a {
    text-decoration: none;
    color: #333;
  }
  
  article a:hover {
    color: #667eea;
  }
  
  .meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.9rem;
    color: #666;
  }
  
  .tags {
    display: flex;
    gap: 0.5rem;
  }
  
  .tag {
    background: #f0f0f0;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }
  
  .featured {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }
</style>